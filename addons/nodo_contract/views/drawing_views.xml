<odoo>
  <record id="view_drawing_upload" model="ir.ui.view">
    <field name="name">nodo.contract.drawing.upload.form</field>
    <field name="model">nodo.contract.drawing</field>
    <field name="arch" type="xml">
      <form string="上传图纸" js_class="nodo_contract_drawing_form">
        <field name="order_id" invisible="1"/>
        <field name="name" invisible="1"/>
        <field name="upload_files" invisible="1"/>
        <group>
          <field name="file_data" filename="name" widget="nodo_contract_drawing_upload" options="{'accepted_file_extensions': '.pdf,.dwg,.dxf,.png,.jpg,.jpeg,.bmp,.tif,.tiff'}"/>
        </group>
        <div class="text-muted">支持一次选择多份 PDF、DWG、DXF 和常用图片，每份文件分别保存。</div>
        <footer>
          <button string="上传" special="save" class="btn-primary"/>
          <button string="取消" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="view_drawing_selection" model="ir.ui.view">
    <field name="name">nodo.contract.drawing.selection.form</field>
    <field name="model">nodo.contract.drawing</field>
    <field name="arch" type="xml">
      <form string="图纸与选型" class="o_sale_drawing_selection" js_class="nodo_contract_drawing_form" dialog_size="xl" create="0">
        <field name="company_id" invisible="1"/>
        <field name="order_id" invisible="1"/>
        <field name="file_kind" invisible="1"/>
        <field name="can_edit_selection" invisible="1"/>
        <field name="drawing_recognition_pending" invisible="1"/>
        <field name="drawing_recognition_version" invisible="1"/>
        <field name="recognition_token" invisible="1"/>
        <field name="orientation_data" invisible="1"/>
        <field name="orientation_token" invisible="1"/>
        <field name="file_data_page" invisible="1"/>
        <field name="page_count" invisible="1"/>
        <field name="product_template_id" invisible="1" domain="[('sale_ok','=',True),('nodo_cabinet_series','!=',False),('company_id','in',[False,company_id])]"/>
        <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
          <field name="name" readonly="1" nolabel="1" class="fw-bold"/>
          <field name="recognition_state" widget="badge" nolabel="1" decoration-info="recognition_state in ('queued', 'processing')" decoration-warning="recognition_state == 'review'" decoration-danger="recognition_state == 'failed'" decoration-success="recognition_state == 'done'"/>
          <field name="state" widget="badge" nolabel="1" decoration-warning="state == 'pending'" decoration-success="state == 'confirmed'"/>
          <field name="file_data" filename="name" readonly="1" nolabel="1"/>
        </div>
        <div class="o_sale_drawing_review">
          <div class="o_sale_drawing_preview">
            <field name="dimension_assist_data" widget="nodo_contract_drawing_dimensions" id="dimension_toolbar" options="{'toolbar': True}" nolabel="1" readonly="not can_edit_selection" invisible="file_kind not in ('pdf', 'image')"/>
            <field name="file_data" id="drawing_pdf" widget="nodo_contract_drawing_pdf" readonly="1" filename="name" nolabel="1" invisible="file_kind != 'pdf'"/>
            <field name="file_data" id="drawing_image" widget="nodo_contract_drawing_image" readonly="1" nolabel="1" invisible="file_kind != 'image'"/>
            <div class="o_sale_drawing_cad text-center text-muted" invisible="file_kind != 'cad'">
              <i class="fa fa-file-code-o fa-3x mb-3" aria-hidden="true"/>
              <p>下载 CAD 原图，核对后填写选型参数。</p>
              <field name="file_data" id="drawing_cad" filename="name" readonly="1" nolabel="1"/>
            </div>
          </div>
          <div class="o_sale_drawing_parameters">
            <div class="alert alert-info" role="status" invisible="recognition_state not in ('queued', 'processing')">

                            后台正在识别，可继续处理其他单据。已处理

                            <field name="recognition_completed_pages" readonly="1" nolabel="1" class="oe_inline"/>

                            / <field name="page_count" readonly="1" nolabel="1" class="oe_inline"/> 页

                        </div>
            <field name="recognition_error" widget="nodo_contract_chinese_recognition_message" readonly="1" nolabel="1" class="text-warning" invisible="not recognition_error"/>
            <group invisible="not active_recognition_id">
              <field name="active_recognition_id" readonly="not can_edit_selection" options="{'no_create': True, 'no_open': True}"/>
              <field name="recognition_summary" widget="nodo_contract_chinese_recognition_message" readonly="1"/>
              <button name="action_apply_recognition" type="object" string="采用当前项目建议" class="btn-outline-primary" invisible="not can_edit_selection"/>
            </group>
            <field name="vision_state" widget="nodo_contract_drawing_vision" readonly="1" nolabel="1"
                   invisible="file_kind != 'pdf'"/>
            <group string="选型参数">
              <field name="product_series" readonly="not can_edit_selection"/>
              <field name="product_template_id" readonly="not can_edit_selection" options="{'no_create': True, 'no_open': True}"
                     domain="[('sale_ok','=',True),('nodo_cabinet_series','!=',False),('company_id','in',[False,company_id])]"/>
              <label for="quantity"/>
              <div class="d-flex align-items-center gap-2">
                <field name="quantity" readonly="not can_edit_selection"/>
                <field name="uom_id" readonly="1" options="{'no_open': True}"/>
              </div>
            </group>
            <group>
              <field name="width_mm" widget="nodo_contract_drawing_dimension_value" readonly="not can_edit_selection" invisible="1"/>
              <field string="宽度（毫米）" name="width_expression" widget="nodo_contract_cabinet_width" readonly="not can_edit_selection"/>
              <field string="深度（毫米）" name="depth_mm" widget="nodo_contract_drawing_dimension_value" readonly="not can_edit_selection"/>
              <field string="高度（毫米）" name="height_mm" widget="nodo_contract_drawing_dimension_value" readonly="not can_edit_selection"/>
              <field name="material" widget="nodo_contract_drawing_material" placeholder="选择材质" readonly="not can_edit_selection"/>
              <field name="door_type" widget="nodo_contract_drawing_door_type" placeholder="选择门型" readonly="not can_edit_selection" invisible="1"/>
              <field name="cabinet_configuration" widget="nodo_contract_cabinet_doors" readonly="not can_edit_selection" nolabel="1" colspan="2"/>
              <field string="箱体料厚（毫米）" name="thickness_mm" readonly="not can_edit_selection"/>
              <field name="base_height_mm" readonly="not can_edit_selection"/>
              <field name="coating_type" readonly="not can_edit_selection"/>
              <field name="display_color" placeholder="填写色号或颜色，如 RAL7035 浅灰" readonly="not can_edit_selection"/>
            </group>
            <group>
              <field name="accessory_selection_data" widget="nodo_contract_drawing_accessories" readonly="not can_edit_selection"/>
              <field name="selection_notes" readonly="not can_edit_selection" placeholder="记录已核对的技术要求与附件说明"/>
              <field name="order_line_id" readonly="1" options="{'no_open': True}"/>
            </group>
            <group invisible="state != 'confirmed'">
              <field name="reviewed_by" options="{'no_open': True}"/>
              <field name="reviewed_at"/>
            </group>
            <details invisible="not source_text">
              <summary class="cursor-pointer mb-2">图纸文字</summary>
              <field name="source_text" readonly="1" nolabel="1" class="o_drawing_source_text"/>
            </details>
          </div>
        </div>
        <footer>
          <button string="重新识别" name="action_recognize" type="object" class="btn-secondary" invisible="not can_edit_selection or recognition_state in ('queued', 'processing')"/>
          <button string="取消识别" name="action_cancel_recognition" type="object" class="btn-secondary" invisible="not can_edit_selection or recognition_state not in ('queued', 'processing')"/>
          <button string="确认选型" name="action_confirm_selection" type="object" class="btn-primary" invisible="not can_edit_selection"/>
          <button string="保存待选型" special="save" class="btn-secondary" invisible="not can_edit_selection"/>
          <button string="关闭" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
