<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 浏览器标题和网站图标 -->
    <template id="layout" inherit_id="web.layout" name="NODO: Web layout">
        <xpath expr="//title" position="replace">
            <title t-out="title or 'NODO'"/>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link type="image/svg+xml" rel="shortcut icon" t-att-href="x_icon or '/nodo_base/static/img/favicon.svg'"/>
            <link rel="apple-touch-icon" href="/nodo_base/static/img/nodo-icon-180.png"/>
        </xpath>
    </template>

    <!-- 母线贯通字标（立体、带开场动画）。动画只用 CSS，系统开启「减少动态效果」时直接显示最终状态。 -->
    <template id="wordmark_animated" name="NODO: Animated wordmark">
        <t t-set="nodo_wm_path" t-value="'M10 66 V18 L42 66 V8 H77 V18 A24 24 0 1 1 77 66 A24 24 0 1 1 77 18 V8 H113 V66 H125 A24 24 0 0 0 125 18 H113 V8 H184 V18 A24 24 0 1 1 184 66 A24 24 0 1 1 184 18 V8 H228'"/>
        <!-- 带错误或提示信息的页面（如密码输错后重新加载）直接显示静态字标，避免每次重播 -->
        <svg t-att-class="'o_nodo_wm o_nodo_wm_static' if (error or message) else 'o_nodo_wm'" viewBox="0 0 250 88" role="img" aria-label="NODO">
            <title>NODO</title>
            <g transform="translate(6,4)">
                <g class="o_nodo_wm_ext">
                    <t t-foreach="[6, 5, 4, 3, 2, 1]" t-as="nodo_layer">
                        <path t-att-d="nodo_wm_path" pathLength="1"
                              t-att-class="'o_nodo_wm_line o_nodo_wm_deep' if nodo_layer &gt; 3 else 'o_nodo_wm_line o_nodo_wm_side'"
                              t-attf-transform="translate({{ '%.2f' % (nodo_layer * 0.85) }},{{ '%.2f' % (nodo_layer * 0.85) }})"/>
                    </t>
                </g>
                <path class="o_nodo_wm_line o_nodo_wm_face" t-att-d="nodo_wm_path" pathLength="1"/>
                <path class="o_nodo_wm_line o_nodo_wm_hl" t-att-d="nodo_wm_path" pathLength="1" transform="translate(-0.9,-1.3)"/>
                <g transform="translate(10 66)">
                    <g class="o_nodo_wm_node o_nodo_wm_node_start">
                        <circle cx="2.2" cy="2.2" r="6" fill="#0B6E4E"/>
                        <circle r="6" fill="#34D399"/>
                        <circle cx="-1.8" cy="-1.8" r="1.7" fill="#FFFFFF" fill-opacity="0.6"/>
                    </g>
                </g>
                <g transform="translate(228 8)">
                    <g class="o_nodo_wm_node o_nodo_wm_node_end">
                        <circle cx="2.2" cy="2.2" r="6" fill="#0B6E4E"/>
                        <circle r="6" fill="#34D399"/>
                        <circle cx="-1.8" cy="-1.8" r="1.7" fill="#FFFFFF" fill-opacity="0.6"/>
                    </g>
                </g>
                <g class="o_nodo_wm_spark">
                    <circle r="7" fill="#34D399" fill-opacity="0.25"/>
                    <circle r="3.4" fill="#D9FFF0"/>
                </g>
            </g>
        </svg>
    </template>

    <!-- 登录页背景：四角淡淡的母线和节点，中间留白 -->
    <template id="login_background" name="NODO: Login background">
        <svg class="o_nodo_login_bg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
            <g class="o_nodo_bg_lines">
                <path d="M-10 190 H90 V76 H250 L306 20 V-10"/>
                <path d="M90 76 V-10"/>
                <path d="M250 76 V150 H370"/>
                <path d="M1450 710 H1350 V824 H1190 L1134 880 V910"/>
                <path d="M1350 824 V910"/>
                <path d="M1190 824 V750 H1070"/>
                <path d="M1450 120 H1330 V40 H1240"/>
                <path d="M-10 780 H110 V860 H200"/>
            </g>
            <g class="o_nodo_bg_nodes">
                <circle cx="90" cy="190" r="5"/><circle cx="90" cy="76" r="5"/><circle cx="250" cy="76" r="5"/>
                <circle cx="306" cy="20" r="5"/><circle cx="250" cy="150" r="5"/>
                <circle cx="1350" cy="710" r="5"/><circle cx="1350" cy="824" r="5"/><circle cx="1190" cy="824" r="5"/>
                <circle cx="1134" cy="880" r="5"/><circle cx="1190" cy="750" r="5"/>
                <circle cx="1330" cy="120" r="5"/><circle cx="1330" cy="40" r="5"/>
                <circle cx="110" cy="780" r="5"/><circle cx="110" cy="860" r="5"/>
            </g>
            <g class="o_nodo_bg_accents">
                <circle cx="370" cy="150" r="5.5"/><circle cx="1070" cy="750" r="5.5"/>
                <circle cx="1240" cy="40" r="5.5"/><circle cx="200" cy="860" r="5.5"/>
            </g>
        </svg>
    </template>

    <!-- 登录、注册、重置密码共用的布局：字标 + 居中卡片 + 页脚，去掉数据库管理和「Powered by」链接 -->
    <template id="login_layout" inherit_id="web.login_layout" name="NODO: Login layout">
        <xpath expr="//div[hasclass('container')][hasclass('py-5')]" position="replace">
            <div class="o_nodo_login">
                <t t-call="nodo_base.login_background"/>
                <div class="o_nodo_login_inner">
                    <div class="o_nodo_login_brand" title="点击重播">
                        <t t-call="nodo_base.wordmark_animated"/>
                    </div>
                    <!-- 点击字标重播开场动画；系统开启「减少动态效果」时不重播。不进 Tab 顺序，键盘焦点仍先到账号框。 -->
                    <script>
                        (function () {
                            var brand = document.currentScript.previousElementSibling;
                            if (!brand) { return; }
                            var mark = brand.querySelector('svg.o_nodo_wm');
                            if (!mark) { return; }
                            var reduce = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;
                            // 点击字标不抢走输入框的焦点
                            brand.addEventListener('mousedown', function (event) { event.preventDefault(); });
                            brand.addEventListener('click', function () {
                                if (reduce ? reduce.matches : false) { return; }
                                mark.classList.add('o_nodo_wm_reset');
                                mark.getBoundingClientRect();
                                mark.classList.remove('o_nodo_wm_reset', 'o_nodo_wm_static');
                            });
                        })();
                    </script>
                    <div class="card o_nodo_login_card o_database_list">
                        <div class="card-body">
                            <!-- 非正式环境标识：系统参数 nodo.environment 为 dev / test 时显示，正式环境不设置 -->
                            <t t-set="nodo_env" t-value="request.env['ir.config_parameter'].sudo().get_str('nodo.environment') if request and request.db else ''"/>
                            <t t-set="nodo_env_label" t-value="{'dev': '开发环境', 'test': '测试环境'}.get(nodo_env)"/>
                            <span t-if="nodo_env_label" class="o_nodo_env_badge" t-out="nodo_env_label"/>
                            <t t-out="0"/>
                        </div>
                    </div>
                    <p class="o_nodo_login_footer">© <t t-out="datetime.date.today().year"/> NODO</p>
                </div>
            </div>
        </xpath>
    </template>

    <!-- 登录表单：可见标题、「账号」标签，未开启邮件重置密码时提示联系管理员 -->
    <template id="login" inherit_id="web.login" name="NODO: Login">
        <xpath expr="//meta[@property='og:site_name']" position="attributes">
            <attribute name="content">NODO</attribute>
        </xpath>
        <xpath expr="//meta[@name='twitter:site']" position="replace"/>
        <xpath expr="//h1[hasclass('visually-hidden')]" position="replace">
            <h1 class="o_nodo_login_title">登录</h1>
            <p class="o_nodo_login_subtitle">使用管理员为你开通的账号</p>
        </xpath>
        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="form-label d-flex justify-content-between">账号</label>
        </xpath>
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="placeholder">name@company.com</attribute>
        </xpath>
        <!-- 登录失败提示：上游文案「错误的登录名/密码」改为更自然的说法，其他错误原样显示 -->
        <xpath expr="//p[hasclass('alert-danger')][@t-if='error']" position="replace">
            <p class="alert alert-danger o_nodo_login_alert" t-if="error" role="alert">
                <t t-out="'账号或密码不正确' if error in ('Wrong login/password', '错误的登录名/密码') else error"/>
            </p>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]" position="after">
            <p t-if="not reset_password_enabled" class="o_nodo_login_hint">忘记密码请联系管理员</p>
        </xpath>
    </template>

    <!-- 门户等页面底部的「Powered by」推广语 -->
    <template id="brand_promotion_message" inherit_id="web.brand_promotion_message" name="NODO: Brand promotion">
        <xpath expr="//t[@t-out]" position="replace"/>
    </template>
</odoo>
