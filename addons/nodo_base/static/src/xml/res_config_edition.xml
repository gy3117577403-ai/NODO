<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- 设置页「关于」：显示 NODO，并保留 LGPL 要求的开源组件与许可证说明 -->
    <t t-inherit="res_config_edition" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('user-heading')]" position="replace">
            <div class="user-heading">
                <h3 class="px-0">NODO</h3>
            </div>
        </xpath>
        <xpath expr="//div[@id='settings']" position="replace">
            <div role="tabpanel" id="settings" class="tab-pane active text-muted o_web_settings_compact_subtitle">
                <small>
                    NODO 基于 Odoo 社区版 <t t-out="this.serverVersion"/> 二次开发。
                    Odoo 社区版由 Odoo S.A. 以
                    <a id="license" target="_blank" href="https://www.gnu.org/licenses/lgpl-3.0.html" style="text-decoration: underline;">GNU LGPL v3</a>
                    许可发布。
                </small>
            </div>
        </xpath>
    </t>
</templates>
