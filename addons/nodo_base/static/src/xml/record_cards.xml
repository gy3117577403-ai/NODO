<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nodo_base.RecordCards">
        <div t-if="this.state.cards.length" class="o_nodo_record_cards">
            <button t-foreach="this.state.cards" t-as="card" t-key="card.key" type="button" class="o_nodo_record_card" t-on-click.stop="() => this.open(card)">
                <span class="o_nodo_record_card_head">
                    <span class="o_nodo_record_card_title" t-out="card.title"/>
                    <span t-if="card.stateLabel" class="o_nodo_record_card_state" t-att-class="card.stateClass" t-out="card.stateLabel"/>
                </span>
                <span t-if="card.subtitle" class="o_nodo_record_card_sub" t-out="card.subtitle"/>
            </button>
        </div>
    </t>

    <!-- 消息正文末尾显示单据卡片 -->
    <t t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Message-body')]" position="inside">
            <NodoRecordCards t-if="!this.isEditing and this.nodoHasRecordRefs" message="this.message"/>
        </xpath>
    </t>
</templates>
