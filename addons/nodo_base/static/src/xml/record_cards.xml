<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nodo_base.RecordCards">
        <div t-if="this.state.cards.length" class="o_nodo_record_cards">
            <button t-foreach="this.state.cards" t-as="card" t-key="this.cardKey(card)" type="button" class="o_nodo_record_card" t-on-click.stop="() => this.open(card)">
                <span class="o_nodo_record_card_head">
                    <span class="o_nodo_record_card_title" t-out="card.title"/>
                    <span t-if="card.status" class="o_nodo_record_card_state" t-att-class="this.statusClass(card)" t-out="card.status"/>
                </span>
                <span t-if="card.subtitle" class="o_nodo_record_card_sub" t-out="card.subtitle"/>
            </button>
        </div>
    </t>

    <!-- 消息正文末尾显示单据卡片 -->
    <t t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Message-body')]" position="inside">
            <NodoRecordCards t-if="!this.isEditing and this.nodoRecordRefs().length"
                refs="this.nodoRecordRefs()" message="this.message" bodyRef="this.messageBody"/>
        </xpath>
    </t>

    <t t-name="nodo_base.RecordTypesDialog">
        <Dialog title="'选择单据类型'" size="'sm'">
            <div class="list-group">
                <button t-foreach="this.props.types" t-as="type" t-key="type.model"
                    class="list-group-item list-group-item-action" type="button" t-on-click="() => this.select(type)"
                    t-out="type.label"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" type="button" t-on-click="this.props.close">取消</button>
            </t>
        </Dialog>
    </t>
</templates>
