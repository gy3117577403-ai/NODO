<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- 讨论窄栏：「聊天」叫「消息」，单据通知分栏叫「单据」并用文件图标 -->
    <t t-inherit="mail.MessagingMenu-navigation" t-inherit-mode="extension">
        <xpath expr="//i[@t-att-data-icon]" position="attributes">
            <attribute name="t-att-data-icon">tab.id === 'notification' ? 'description' : (this.activeTab().eq(tab) and tab.activeIcon ? tab.activeIcon : tab.icon)</attribute>
        </xpath>
        <xpath expr="//span[hasclass('o-xsmaller')]" position="attributes">
            <attribute name="t-out">({chat: '消息', notification: '单据'})[tab.id] or tab.label</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-MessagingMenu-tab')]" position="attributes">
            <attribute name="t-att-aria-label">({chat: '消息', notification: '单据'})[tab.id] or tab.label</attribute>
        </xpath>
    </t>

    <!-- 「消息」分栏按类型分组：私聊下面各列最近的频道和单据 -->
    <t t-inherit="mail.MessagingMenu" t-inherit-mode="extension">
        <xpath expr="//MessagingMenuItem[@t-foreach='this.channels()']" position="after">
            <t t-set="nodoGroups" t-value="this.nodoGroups()"/>
            <t t-if="nodoGroups.channels.length">
                <div class="o_nodo_group_header">
                    <span>频道</span>
                    <button type="button" class="btn btn-link p-0" t-on-click="() => this.state().selectTab(nodoGroups.channelTab)">全部</button>
                </div>
                <MessagingMenuItem
                    t-foreach="nodoGroups.channels" t-as="channel" t-key="'nodo_channel_' + channel.localId"
                    channel="channel"
                    activeTab="() => nodoGroups.channelTab"
                    onClick="this.onClickChannel"
                />
            </t>
            <t t-if="nodoGroups.documents.length">
                <div class="o_nodo_group_header">
                    <span>单据</span>
                    <button type="button" class="btn btn-link p-0" t-on-click="() => this.state().selectTab(nodoGroups.documentTab)">全部</button>
                </div>
                <MessagingMenuItem
                    t-foreach="nodoGroups.documents" t-as="message" t-key="'nodo_document_' + message.localId"
                    message="message"
                    activeTab="() => nodoGroups.documentTab"
                    onClick="this.onClickMessage"
                />
            </t>
        </xpath>
    </t>

    <!-- 开启桌面通知的提示：换成品牌色和更直白的文案 -->
    <t t-inherit="mail.MessagingMenu" t-inherit-mode="extension">
        <xpath expr="//NotificationItem[@t-if='this.showPushPermissionRequest']" position="attributes">
            <attribute name="className">'o_nodo_push_request o-my-0_5'</attribute>
            <attribute name="onClick">this.onNodoEnableNotifications</attribute>
        </xpath>
        <xpath expr="//NotificationItem[@t-if='this.showPushPermissionRequest']//a[hasclass('btn-info')]" position="replace">
            <button t-if="this.nodoCanRequestPermission" type="button" class="btn btn-primary btn-sm rounded-pill px-2 py-0" t-on-click.stop="this.onNodoEnableNotifications">开启</button>
        </xpath>
        <xpath expr="//NotificationItem[@t-if='this.showPushPermissionRequest']//span[@data-icon='close_small']" position="replace">
            <button type="button" class="btn btn-sm p-0 text-reset" title="关闭通知提示" aria-label="关闭通知提示" t-on-click.stop="this.onNodoDismissNotificationHint">
                <i class="oi" data-icon="close_small"/>
            </button>
        </xpath>
    </t>

    <!-- 没有选中对话时的提示 -->
    <t t-inherit="mail.DiscussContent" t-inherit-mode="extension">
        <xpath expr="//h4[hasclass('text-muted')]" position="replace">
            <div class="o_nodo_discuss_empty text-center">
                <svg class="o_nodo_discuss_empty_mark" viewBox="0 0 52 76" aria-hidden="true">
                    <path d="M10 66 V18 L42 66 V8" fill="none" stroke="currentColor" stroke-width="8" stroke-linejoin="round" stroke-linecap="round"/>
                    <circle cx="10" cy="66" r="7" class="o_nodo_node"/>
                    <circle cx="42" cy="8" r="7" class="o_nodo_node"/>
                </svg>
                <div class="o_nodo_discuss_empty_title">选择一个对话</div>
                <div class="o_nodo_discuss_empty_hint">从左侧选择同事、频道或单据，或点击「聊天」发起新的对话</div>
            </div>
        </xpath>
    </t>
</templates>
