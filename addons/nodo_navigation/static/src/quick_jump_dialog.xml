<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nodo_navigation.QuickJumpDialog">
        <Dialog title="'快速跳转'" size="'md'" footer="false" contentClass="'o_nodo_quick_jump'">
            <form class="o_nodo_quick_jump_search" role="search" t-on-submit.prevent="this.openFirstResult">
                <i class="oi" data-icon="search" aria-hidden="true"/>
                <input type="search" aria-label="搜索应用或功能" placeholder="搜索应用或功能"
                       autocomplete="off" t-ref="this.searchInput" t-on-input="this.updateQuery"/>
            </form>
            <t t-if="this.results().length">
                <p t-if="!this.query().trim()" class="o_nodo_quick_jump_label">常用入口</p>
                <ul class="o_nodo_quick_jump_results" aria-label="可跳转的功能">
                    <li t-foreach="this.results()" t-as="entry" t-key="entry.menu.id">
                        <button type="button" class="o_nodo_quick_jump_result"
                                t-att-disabled="this.opening()" t-on-click="() => this.openEntry(entry)">
                            <span class="o_nodo_quick_jump_icon" aria-hidden="true">
                                <i class="oi" t-att-data-icon="entry.icon"/>
                            </span>
                            <span class="o_nodo_quick_jump_description">
                                <span class="o_nodo_quick_jump_name" t-out="entry.label"/>
                                <span t-if="entry.path" class="o_nodo_quick_jump_path" t-out="entry.path"/>
                            </span>
                            <i class="oi o_nodo_quick_jump_arrow" data-icon="chevron_right" aria-hidden="true"/>
                        </button>
                    </li>
                </ul>
            </t>
            <p t-else="" class="o_nodo_quick_jump_empty" role="status">没有找到匹配的功能</p>
        </Dialog>
    </t>
</templates>
