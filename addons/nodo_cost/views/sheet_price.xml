<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sheet_price_list" model="ir.ui.view">
        <field name="name">nodo.cost.sheet.price.list</field>
        <field name="model">nodo.cost.sheet.price</field>
        <field name="arch" type="xml">
            <list string="板料成本" delete="0">
                <field name="category"/><field name="grade"/><field name="supply_condition"/>
                <field name="thickness_mm"/><field name="price_per_kg"/>
                <field name="basis" widget="badge" decoration-warning="basis == 'trial'" decoration-success="basis == 'business'"/>
                <field name="source_note" optional="show"/><field name="write_date" string="更新时间" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="sheet_price_form" model="ir.ui.view">
        <field name="name">nodo.cost.sheet.price.form</field><field name="model">nodo.cost.sheet.price</field>
        <field name="arch" type="xml">
            <form string="板料成本" delete="0">
                <sheet>
                    <widget name="web_ribbon" title="已归档" bg_color="text-bg-secondary" invisible="active"/>
                    <group><group string="板料规格">
                        <field name="category"/><field name="grade"/><field name="supply_condition"/><field name="thickness_mm"/>
                    </group><group string="成本价格">
                        <field name="price_per_kg"/><field name="basis"/><field name="source_note"/>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        <field name="active" invisible="1"/>
                    </group></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sheet_price_search" model="ir.ui.view">
        <field name="name">nodo.cost.sheet.price.search</field><field name="model">nodo.cost.sheet.price</field>
        <field name="arch" type="xml">
            <search><field name="category"/><field name="grade"/><field name="supply_condition"/><field name="thickness_mm"/>
                <filter name="trial" string="测试价" domain="[('basis','=','trial')]"/>
                <separator/><filter name="archived" string="已归档" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>
    <record id="action_sheet_prices" model="ir.actions.act_window">
        <field name="name">板料成本</field><field name="res_model">nodo.cost.sheet.price</field>
        <field name="path">sheet-costs</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sheet_price_search"/>
    </record>
    <menuitem id="menu_root" name="成本库" sequence="46" groups="nodo_base.group_role_costing,nodo_base.group_role_engineering,base.group_system"/>
    <menuitem id="menu_sheet_prices" name="板料成本" parent="menu_root" action="action_sheet_prices" sequence="10"/>
</odoo>
