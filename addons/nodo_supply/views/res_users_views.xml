<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_nodo_purchase_permissions" model="ir.ui.view">
        <field name="name">res.users.form.nodo.purchase.permissions</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <page name="access_rights" position="after">
                <page name="nodo_purchase_permissions" string="个人权限" groups="base.group_system" invisible="share">
                    <separator string="采购单"/>
                    <div class="text-muted mb-2">
                        个人设置优先于岗位权限。选择「岗位默认」可恢复继承。单据操作同时受公司、负责范围和单据状态约束。
                    </div>
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr><th>权限项目</th><th>个人设置</th><th>当前生效</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><label for="nodo_purchase_view"/></td>
                                <td><field name="nodo_purchase_view"/></td>
                                <td><field name="nodo_purchase_view_status" readonly="1"/></td>
                            </tr>
                            <tr>
                                <td><label for="nodo_purchase_price"/></td>
                                <td><field name="nodo_purchase_price"/></td>
                                <td><field name="nodo_purchase_price_status" readonly="1"/></td>
                            </tr>
                            <tr>
                                <td><label for="nodo_purchase_draft"/></td>
                                <td><field name="nodo_purchase_draft"/></td>
                                <td><field name="nodo_purchase_draft_status" readonly="1"/></td>
                            </tr>
                            <tr>
                                <td><label for="nodo_purchase_review"/></td>
                                <td><field name="nodo_purchase_review"/></td>
                                <td><field name="nodo_purchase_review_status" readonly="1"/></td>
                            </tr>
                            <tr>
                                <td><label for="nodo_purchase_confirm"/></td>
                                <td><field name="nodo_purchase_confirm"/></td>
                                <td><field name="nodo_purchase_confirm_status" readonly="1"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <separator string="权限变更记录"/>
                    <field name="nodo_permission_change_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0" limit="20">
                            <field name="create_date" string="时间"/>
                            <field name="create_uid" string="调整人"/>
                            <field name="permission_name"/>
                            <field name="old_mode"/>
                            <field name="new_mode"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
