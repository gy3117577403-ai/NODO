<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nodo_staff_import.EmployeePlanScope">
        <span t-att-class="{'o_nodo_employee_plan_general': !this.department}" t-out="this.department || '通用'"/>
    </t>

    <t t-name="nodo_staff_import.EmployeePlanDeadline">
        <span t-out="this.label"/>
    </t>

    <t t-name="nodo_staff_import.EmployeePlanHeader">
        <header class="o_nodo_staff_page_header" t-if="!this.env.inDialog">
            <div>
                <h1>员工计划</h1>
                <p t-if="this.planCountLabel" role="status" t-out="this.planCountLabel"/>
            </div>
            <div class="o_nodo_staff_actions" t-if="this.canCreatePlan">
                <button type="button" class="btn btn-primary text-nowrap" accesskey="c"
                        t-att-disabled="this.offlinePlugin.isOffline()" t-on-click="() => this.createRecord()">
                    <i class="oi" data-icon="add" aria-hidden="true"/> 新建计划
                </button>
            </div>
        </header>
    </t>

    <t t-name="nodo_staff_import.EmployeePlanList" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="before">
            <t t-call="nodo_staff_import.EmployeePlanHeader"/>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-buttons']/t[1]" position="replace"/>
    </t>

    <t t-name="nodo_staff_import.EmployeePlanKanban" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="before">
            <t t-call="nodo_staff_import.EmployeePlanHeader"/>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-buttons']/t[1]" position="replace"/>
    </t>

    <t t-name="nodo_staff_import.EmployeePlanControlPanel"
       t-inherit="nodo_staff_import.StaffDirectoryControlPanel" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_cp_switch_buttons')]/Dropdown/button" position="attributes">
            <attribute name="class" add="o-dropdown-caret" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_cp_switch_buttons')]/Dropdown/button/span[hasclass('ms-1')]" position="attributes">
            <attribute name="t-out">activeView.name</attribute>
        </xpath>
    </t>

    <t t-name="nodo_staff_import.EmployeePlanSearchBar" t-inherit="web.SearchBar" t-inherit-mode="primary">
        <xpath expr="//input[@role='searchbox']" position="attributes">
            <attribute name="placeholder">搜索计划名称</attribute>
        </xpath>
    </t>
</templates>
