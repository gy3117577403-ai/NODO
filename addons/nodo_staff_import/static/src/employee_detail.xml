<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nodo_staff_import.StaffAvatarField" t-inherit="web.ImageField" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('opacity-trigger-hover')]" position="attributes">
            <attribute name="class">o_nodo_avatar_control</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_select_file_button')]" position="replace">
            <button type="button" class="o_nodo_avatar_upload btn">上传头像</button>
        </xpath>
        <xpath expr="//button[hasclass('o_clear_file_button')]" position="attributes">
            <attribute name="type">button</attribute>
            <attribute name="data-tooltip">移除头像</attribute>
            <attribute name="aria-label">移除头像</attribute>
        </xpath>
    </t>

    <t t-name="nodo_staff_import.StaffJobField">
        <div class="d-flex align-items-center gap-2">
            <div class="flex-grow-1"><Many2One t-props="this.m2oProps"/></div>
            <button t-if="!this.props.readonly &amp;&amp; (this.props.record.data[this.props.name] || this.props.record.data.job_title)"
                    type="button" class="btn btn-link p-0 flex-shrink-0" aria-label="清空岗位"
                    t-on-click.stop="this.clearJob">清空</button>
        </div>
    </t>
</templates>
