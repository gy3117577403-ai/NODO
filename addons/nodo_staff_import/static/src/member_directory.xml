<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nodo_staff_import.StaffDirectory" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="before">
            <header class="o_nodo_staff_page_header" t-if="!this.env.inDialog">
                <div>
                    <h1>员工名单</h1>
                    <p t-if="this.memberCountLabel" role="status" t-out="this.memberCountLabel"/>
                </div>
                <div t-if="this.nodoCanAddMember and !this.hasSelectedRecords and !this.editedRecord"
                     class="o_nodo_staff_actions d-inline-flex gap-2">
                    <button type="button" class="btn btn-secondary text-nowrap" t-on-click="this.importMembers"
                            t-att-disabled="this.offlinePlugin.isOffline()">导入人员</button>
                    <button type="button" class="btn btn-primary o_nodo_add_member text-nowrap"
                            t-on-click="this.openMemberDialog"
                            t-att-disabled="this.openingMember() or this.offlinePlugin.isOffline()">
                        <i class="oi" data-icon="add" aria-hidden="true"/> 添加成员
                    </button>
                </div>
            </header>
        </xpath>
    </t>

    <t t-name="nodo_staff_import.StaffDirectoryLayout" t-inherit="web.Layout" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='this.components.ControlPanel']" position="replace"/>
        <xpath expr="//main[hasclass('o_content')]" position="attributes">
            <attribute name="class" add="o_nodo_staff_workspace" separator=" "/>
        </xpath>
        <xpath expr="//t[@t-call-slot='default']" position="replace">
            <section class="o_nodo_roster_card" aria-label="员工名单">
                <t t-component="this.components.ControlPanel" slots="this.controlPanelSlots"
                   t-if="this.props.display.controlPanel" display="this.props.display.controlPanel"/>
                <t t-call-slot="default" contentRef="this.contentRef"/>
            </section>
        </xpath>
    </t>

    <t t-name="nodo_staff_import.StaffDirectoryControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_control_panel_breadcrumbs')]/t[@t-elif]" position="replace"/>
        <xpath expr="//div[hasclass('o_control_panel_breadcrumbs')]/t[@t-else]" position="replace"/>
        <xpath expr="//t[@t-if='this.env.config.noBreadcrumbs']" position="attributes">
            <attribute name="t-if"/>
        </xpath>
        <xpath expr="//div[hasclass('o_cp_pager')]" position="attributes">
            <attribute name="t-if">this.pagerProps and this.pagerProps.total > this.pagerProps.limit</attribute>
        </xpath>
        <xpath expr="//nav[hasclass('o_cp_switch_buttons')]" position="replace"/>
        <xpath expr="//div[hasclass('o_cp_switch_buttons')]" position="attributes">
            <attribute name="t-if"/>
        </xpath>
        <xpath expr="//div[hasclass('o_cp_switch_buttons')]/Dropdown" position="attributes">
            <attribute name="menuClass">{o_cp_switch_buttons: true, o_custom_bottom_sheet: this.uiService.isSmall}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_cp_switch_buttons')]/Dropdown/button" position="attributes">
            <attribute name="aria-label">切换视图</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_cp_switch_buttons')]/Dropdown/button" position="inside">
            <span class="ms-1">视图</span>
        </xpath>
    </t>

    <t t-name="nodo_staff_import.StaffDirectory.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
        <xpath expr="//button[hasclass('o_list_button_add')]" position="attributes">
            <attribute name="t-if" add="!this.nodoCanAddMember" separator=" and "/>
        </xpath>
    </t>

    <t t-name="nodo_staff_import.StaffMemberIdentity">
        <div class="o_nodo_staff_identity">
            <div class="o_nodo_staff_name_line" t-att-class="{'o_nodo_staff_leader': this.leadershipLabel}">
                <span class="o_nodo_staff_name" t-out="this.props.record.data[this.props.name]"/>
                <span t-if="this.leadershipLabel" class="o_nodo_staff_leadership" t-out="this.leadershipLabel"/>
            </div>
            <span t-if="this.props.record.data.nodo_personnel_number" class="o_nodo_staff_number"
                  t-out="this.props.record.data.nodo_personnel_number"/>
        </div>
    </t>

    <t t-name="nodo_staff_import.StaffDepartment">
        <div t-if="this.level" class="o_nodo_staff_department">
            <span class="o_nodo_department_level" t-att-data-level="this.level" t-out="this.levelLabel"/>
            <div class="o_nodo_staff_department_path" t-out="this.props.record.data[this.props.name]"/>
        </div>
    </t>

    <t t-name="nodo_staff_import.DepartmentCategory" t-inherit="web.SearchPanel.Category" t-inherit-mode="primary">
        <xpath expr="//span[hasclass('o_search_panel_label_title')]" position="before">
            <t t-set="level" t-value="this.departmentLevel(section, valueId)"/>
            <span t-if="level" class="o_nodo_department_level" t-att-data-level="level"
                  t-out="this.departmentLevelLabel(level)"/>
        </xpath>
    </t>

    <t t-name="nodo_staff_import.MemberDialog">
        <t t-call="nodo_staff_import.StaffDialogFrame" dialogClass="'nodo-member-dialog'"
           titleId="'nodo-member-title'" title="'添加成员'"
           submitLabel="this.matches().length ? '添加同名成员' : '添加成员'">
            <fieldset class="staff-fields staff-member-fields" t-att-disabled="this.saving()">
                <div>
                    <label for="nodo-member-name">姓名 <span class="staff-required" aria-hidden="true">*</span></label>
                    <input id="nodo-member-name" name="name" required="required" autofocus="autofocus"
                           placeholder="输入员工姓名" autocomplete="off" t-att-value="this.draft().name"
                           t-on-input="this.changeField" aria-describedby="nodo-member-name-error"
                           t-att-aria-invalid="this.problem()?.field === 'name' ? 'true' : undefined"/>
                    <p id="nodo-member-name-error" class="staff-error" role="alert"
                       t-if="this.problem()?.field === 'name'" t-out="this.problem().message"/>
                </div>
                <div>
                    <label for="nodo-member-department">部门 <span class="staff-required" aria-hidden="true">*</span></label>
                    <select id="nodo-member-department" name="department" required="required"
                            t-on-change="this.changeField" aria-describedby="nodo-member-department-error"
                            t-att-aria-invalid="this.problem()?.field === 'department' ? 'true' : undefined">
                        <option value="" t-att-selected="!this.draft().department">请选择部门</option>
                        <option t-foreach="this.props.options.departments" t-as="item" t-key="item.id"
                                t-att-value="item.id" t-att-selected="item.id === this.draft().department"
                                t-out="item.complete_name"/>
                    </select>
                    <p id="nodo-member-department-error" class="staff-error" role="alert"
                       t-if="this.problem()?.field === 'department'" t-out="this.problem().message"/>
                </div>
                <div>
                    <label for="nodo-member-number">人员编号</label>
                    <input id="nodo-member-number" name="number" placeholder="可稍后填写"
                           autocomplete="off" t-att-value="this.draft().number"
                           t-on-input="this.changeField" aria-describedby="nodo-member-number-error"
                           t-att-aria-invalid="this.problem()?.field === 'number' ? 'true' : undefined"/>
                    <div id="nodo-member-number-error" class="staff-error" role="alert"
                         t-if="this.problem()?.field === 'number'">
                        <span t-out="this.problem().message"/>
                        <button t-if="this.problem().employeeId" type="button" class="staff-member-link"
                                t-on-click="this.viewExisting">查看已有档案</button>
                    </div>
                </div>
                <div>
                    <label for="nodo-member-job">岗位</label>
                    <select id="nodo-member-job" name="job" t-on-change="this.changeField"
                            t-att-disabled="!this.jobs.length" aria-describedby="nodo-member-job-error"
                            t-att-aria-invalid="this.problem()?.field === 'job' ? 'true' : undefined">
                        <option value="" t-att-selected="!this.draft().job">
                            <t t-if="!this.draft().department">请先选择部门</t>
                            <t t-elif="!this.jobs.length">该部门暂无岗位</t>
                            <t t-else="">可稍后选择</t>
                        </option>
                        <option t-foreach="this.jobs" t-as="job" t-key="job.id"
                                t-att-value="job.id" t-att-selected="job.id === this.draft().job"
                                t-out="job.name"/>
                    </select>
                    <p id="nodo-member-job-error" class="staff-error" role="alert"
                       t-if="this.problem()?.field === 'job'" t-out="this.problem().message"/>
                </div>
            </fieldset>
            <div t-if="this.matches().length" class="staff-member-matches" role="status" tabindex="-1">
                <strong>已有同名档案</strong>
                <ul>
                    <li t-foreach="this.matches()" t-as="match" t-key="match.id">
                        <t t-out="match.department"/> · <t t-out="match.number"/>
                    </li>
                </ul>
                <p>核对为不同员工后，可以继续添加。</p>
            </div>
            <p t-if="this.problem() and !this.problem().field" class="staff-error staff-save-error"
               role="alert" tabindex="-1" t-out="this.problem().message"/>
        </t>
    </t>
</templates>
