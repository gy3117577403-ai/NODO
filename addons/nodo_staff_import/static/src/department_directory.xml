<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nodo_staff_import.DepartmentDirectory" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="before">
            <header class="o_nodo_staff_page_header" t-if="!this.env.inDialog">
                <div>
                    <h1>部门</h1>
                    <p t-if="this.departmentCountLabel" role="status" t-out="this.departmentCountLabel"/>
                </div>
                <div t-if="this.canCreate" class="o_nodo_staff_actions">
                    <button type="button" class="btn btn-primary text-nowrap" accesskey="c"
                            t-on-click="() => this.createRecord()" t-att-disabled="this.isNewButtonDisabled"
                            t-att-data-available-offline="this.isNewButtonAvailableOffline">
                        <i class="oi" data-icon="add" aria-hidden="true"/> 新建部门
                    </button>
                </div>
            </header>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-buttons']/t[1]" position="replace"/>
    </t>

    <t t-name="nodo_staff_import.DepartmentDirectoryWithToolbar"
       t-inherit="nodo_staff_import.DepartmentDirectory" t-inherit-mode="primary">
        <xpath expr="//SearchBar" position="attributes">
            <attribute name="toggler"/>
            <attribute name="autofocus">this.firstLoad and !this.uiService.isSmall</attribute>
        </xpath>
        <xpath expr="//t[@t-component='this.searchBarToggler.component']" position="replace"/>
    </t>

    <t t-name="nodo_staff_import.DepartmentDirectoryLayout" t-inherit="web.Layout" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='this.components.ControlPanel']" position="replace"/>
        <xpath expr="//main" position="replace">
            <div class="o_nodo_staff_workspace o_nodo_department_workspace"
                 t-att-class="{'o_component_with_search_panel': this.props.display.searchPanel}">
                <t t-component="this.components.SearchPanel" t-if="this.props.display.searchPanel"/>
                <section class="o_nodo_roster_card" t-att-aria-label="this.constructor.rosterLabel">
                    <t t-component="this.components.ControlPanel" slots="this.controlPanelSlots"
                       t-if="this.props.display.controlPanel" display="this.props.display.controlPanel"/>
                    <main t-ref="this.contentRef" class="o_content o_nodo_department_card_scroll"
                          t-attf-class="{{ this.props.className }}" tabindex="0" aria-label="部门卡片滚动区域">
                        <t t-call-slot="default" contentRef="this.contentRef"/>
                    </main>
                </section>
            </div>
        </xpath>
    </t>

    <t t-name="nodo_staff_import.DepartmentDirectoryControlPanel"
       t-inherit="nodo_staff_import.StaffDirectoryControlPanel" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_control_panel_breadcrumbs')]//t[@t-call-slot='control-panel-additional-actions']"
               position="replace"/>
        <xpath expr="//div[hasclass('o_control_panel_navigation')]//t[@t-call-slot='control-panel-additional-actions']"
               position="replace"/>
        <xpath expr="//div[hasclass('o_control_panel_navigation')]" position="inside">
            <div class="o_nodo_department_toolbar_more d-empty-none">
                <t t-call-slot="control-panel-additional-actions"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_cp_switch_buttons')]/Dropdown/button" position="attributes">
            <attribute name="class" add="o-dropdown-caret" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_cp_switch_buttons')]/Dropdown/button/span[hasclass('ms-1')]" position="attributes">
            <attribute name="t-out">activeView.name</attribute>
        </xpath>
    </t>

    <t t-name="nodo_staff_import.DepartmentDirectorySearchBar" t-inherit="web.SearchBar" t-inherit-mode="primary">
        <xpath expr="//input[@role='searchbox']" position="attributes">
            <attribute name="placeholder">搜索部门名称或路径</attribute>
        </xpath>
    </t>

    <t t-name="nodo_staff_import.DepartmentIdentity">
        <div class="o_nodo_department_identity">
            <span class="o_nodo_department_name" t-att-data-department-id="this.department?.id"
                  t-att-style="this.nameStyle" t-out="this.props.record.data[this.props.name]"/>
            <span t-if="this.parentPath" class="o_nodo_department_parent_path" t-out="this.parentPath"/>
        </div>
    </t>
</templates>
