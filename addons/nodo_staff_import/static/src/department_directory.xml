<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nodo_staff_import.DepartmentDirectory" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="before">
            <header class="o_nodo_staff_page_header" t-if="!this.env.inDialog">
                <div>
                    <h1>部门</h1>
                    <p t-if="this.departmentCountLabel" role="status" t-out="this.departmentCountLabel"/>
                </div>
                <div t-if="this.canCreate" class="o_nodo_staff_actions">
                    <button type="button" class="btn btn-primary text-nowrap" accesskey="c"
                            t-on-click="() => this.createRecord()" t-att-disabled="this.isNewButtonDisabled"
                            t-att-data-available-offline="this.isNewButtonAvailableOffline">
                        <i class="oi" data-icon="add" aria-hidden="true"/> 新建部门
                    </button>
                </div>
            </header>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-buttons']/t[1]" position="replace"/>
    </t>

    <t t-name="nodo_staff_import.DepartmentDirectorySearchBar" t-inherit="web.SearchBar" t-inherit-mode="primary">
        <xpath expr="//input[@role='searchbox']" position="attributes">
            <attribute name="placeholder">搜索部门名称或路径</attribute>
        </xpath>
    </t>

    <t t-name="nodo_staff_import.DepartmentIdentity">
        <div class="o_nodo_department_identity">
            <span class="o_nodo_department_name" t-att-data-department-id="this.department?.id"
                  t-att-style="this.nameStyle" t-out="this.props.record.data[this.props.name]"/>
            <span t-if="this.parentPath" class="o_nodo_department_parent_path" t-out="this.parentPath"/>
        </div>
    </t>
</templates>
