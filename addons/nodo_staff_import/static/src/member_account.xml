<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nodo_staff_import.MemberAccountDialog">
        <t t-call="nodo_staff_import.StaffDialogFrame" dialogClass="'nodo-account-dialog'"
           titleId="'nodo-account-title'" title="'开通账号'" submitLabel="'开通账号'">
            <t t-call="nodo_staff_import.StaffAccountSummary" person="this.props.employee" login="false"/>
            <fieldset class="staff-fields" t-att-disabled="this.saving()">
                <div>
                    <label for="nodo-account-login">登录名 <span class="staff-required" aria-hidden="true">*</span></label>
                    <input id="nodo-account-login" name="login" required="required" autofocus="autofocus"
                           placeholder="输入登录名" autocomplete="off" autocapitalize="none" spellcheck="false"
                           t-att-value="this.login()" t-on-input="this.changeLogin"
                           t-att-aria-describedby="this.problem()?.field ? 'nodo-account-error nodo-account-hint' : 'nodo-account-hint'"
                           t-att-aria-invalid="this.problem()?.field ? 'true' : undefined"/>
                    <p t-if="this.problem()?.field" id="nodo-account-error" class="staff-error"
                       role="alert" t-out="this.problem().message"/>
                    <p id="nodo-account-hint" class="staff-account-hint">开通后，在关联用户中设置密码和业务角色。</p>
                </div>
            </fieldset>
            <p t-if="this.problem() and !this.problem().field" class="staff-error staff-save-error"
               role="alert" tabindex="-1" t-out="this.problem().message"/>
        </t>
    </t>
</templates>
