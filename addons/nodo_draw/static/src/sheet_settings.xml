<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="nodo_draw.SheetSettings">
    <div class="nd-between nd-stock-heading">
        <h3 t-out="this.byPart() ? '按零件设置' : '材料与板厚'"/>
        <button type="button" t-att-aria-expanded="this.byPart()?'true':'false'" t-on-click="this.toggleMode" t-out="this.byPart() ? '返回分组' : '按零件'"/>
    </div>
    <div class="nd-stock-row" t-foreach="this.rows()" t-as="row" t-key="row.key">
        <div class="nd-between nd-stock-label">
            <strong t-out="row.name"/>
            <small t-if="row.source" t-out="row.source"/>
            <button t-elif="row.overrides" type="button" class="nd-link" t-on-click="this.toggleMode"><t t-out="row.overrides"/> 项独立</button>
        </div>
        <div class="nd-stock-fields">
            <select t-att-aria-label="row.name+(this.byPart()?'独立材料':'材料')" t-att-disabled="this.props.disabled"
                    t-on-change="ev => this.changeCategory(row,ev.target.value)">
                <option t-foreach="Object.entries(this.props.catalog.materials.categories)" t-as="choice" t-key="choice[0]"
                        t-att-value="choice[0]" t-att-selected="row.material.category===choice[0]" t-out="choice[1].name"/>
            </select>
            <label class="nd-gauge">
                <input type="number" step="0.1" t-att-min="row.rule.min" t-att-max="row.rule.max" t-att-value="row.thickness ?? ''"
                       t-att-aria-label="row.name+(this.byPart()?'独立厚度':'厚度')" t-att-disabled="this.props.disabled"
                       t-on-input="ev => this.changeThickness(row.key,ev.target.value)"/><small>mm</small>
            </label>
            <button type="button" t-att-aria-label="row.name+'材料详情'" t-att-aria-expanded="this.detail()===row.key?'true':'false'"
                    t-on-click="() => this.detail.set(this.detail()===row.key?null:row.key)">⋯</button>
        </div>
        <button t-if="row.independent" type="button" class="nd-follow" t-att-aria-label="row.name+'恢复跟随'"
                t-att-disabled="this.props.disabled" t-on-click="() => this.restore(row.key)">恢复跟随</button>
        <div class="nd-stock-details" t-if="this.detail()===row.key">
            <label t-foreach="this.fields" t-as="field" t-key="field[0]">
                <t t-out="field[1]"/>
                <input type="text" maxlength="120" t-att-value="row.material[field[0]] || ''"
                       t-att-aria-label="row.name+field[1]" t-att-disabled="this.props.disabled"
                       t-on-input="ev => this.changeDetail(row,field[0],ev.target.value)"/>
            </label>
        </div>
    </div>
    <button type="button" class="nd-wide nd-soft" t-att-disabled="this.props.disabled" t-on-click="this.props.save">应用材料并预览</button>
</t>
</templates>
