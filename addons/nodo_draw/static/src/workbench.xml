<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="nodo_draw.WorkbenchNavigation" t-inherit="web.NavBar" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_menu_systray')]" position="before">
        <div class="nd-workbar-slot"/>
    </xpath>
</t>
<t t-name="nodo_draw.Workbench">
<main class="nd-work" aria-label="柜体设计">
    <div t-if="!this.doc()" class="nd-empty">暂无已交接的柜体 BOM</div>
    <t t-else="">
    <t t-set="doc" t-value="this.doc()"/><t t-set="form" t-value="this.form()"/>
    <t t-set="job" t-value="this.showFiles() ? this.selectedDrawing() : null"/>
    <t t-set="sheet" t-value="job?.state==='done' ? this.selectedSheet(job) : null"/>
    <Portal target="'.nd-workbar-slot'">
    <t t-set="doc" t-value="this.doc()"/>
    <t t-set="job" t-value="this.showFiles() ? this.selectedDrawing() : null"/>
    <t t-set="sheet" t-value="job?.state==='done' ? this.selectedSheet(job) : null"/>
    <div class="nd-workbar" role="toolbar" aria-label="柜体设计工具栏">
        <div class="nd-context">
            <select class="nd-design-choice" aria-label="选择设计" t-on-change="this.selectDesign"
                    t-att-title="'交接版 '+doc.bom.source_version+' · '+doc.bom.quantity+' 台'">
                <option t-foreach="this.docs()" t-as="d" t-key="d.id" t-att-value="d.id" t-att-selected="d.id===doc.id" t-out="this.designLabel(d)"/>
            </select>
            <select t-if="this.showFiles()" class="nd-version-choice" aria-label="图纸版本" t-on-change="this.selectDrawingVersion">
                <optgroup label="基础原图">
                    <option t-foreach="Object.values(this.referenceDrawings())" t-as="ref" t-key="ref.kind" t-att-value="'original-'+ref.kind"
                            t-att-selected="job?.id==='original-'+ref.kind" t-out="ref.label"/>
                </optgroup>
                <optgroup t-if="this.builds().length" label="出图版本">
                    <option t-foreach="this.builds()" t-as="j" t-key="j.id" t-att-value="j.id" t-att-selected="j.id===job?.id">V<t t-out="this.version(j.version)"/> · <t t-out="this.jobState(j)"/></option>
                </optgroup>
            </select>
            <span t-if="job?.reference" class="nd-tag" title="原图尺寸（宽 × 高 × 深）" aria-label="原图尺寸（宽 × 高 × 深）"><t t-out="job.dimensions.width"/> × <t t-out="job.dimensions.height"/> × <t t-out="job.dimensions.depth"/> mm</span>
            <span t-elif="job?.state==='done'" class="nd-tag">待工艺校核</span>
            <button t-if="!this.showFiles()" type="button" class="nd-primary" t-att-disabled="this.busy()" t-on-click="() => this.apply('generate')">一键出图</button>
            <span t-if="!this.showFiles() &amp;&amp; !doc.online" class="nd-offline" role="status" title="计算服务离线" aria-label="计算服务离线">
                <i class="fa fa-exclamation-circle" aria-hidden="true"/>
            </span>
        </div>
        <div class="nd-workbar-views" role="group" aria-label="工作台视图">
            <button type="button" t-att-aria-pressed="!this.showFiles()?'true':'false'" t-on-click="this.openDesign">设计视图</button>
            <button type="button" t-if="!this.showFiles()" t-on-click="() => this.openReference()">基础原图</button>
            <button type="button" t-if="!this.showFiles()" t-on-click="this.openArchive">图纸与版本</button>
        </div>
        <div class="nd-workbar-views" role="group" aria-label="设计视口" t-if="!this.showFiles()">
            <button type="button" t-att-aria-pressed="this.mode()==='3d' &amp;&amp; !this.drilling()?'true':'false'" t-on-click="this.showThree">三维</button>
            <button type="button" t-att-aria-pressed="this.drilling()?'true':'false'" t-on-click="this.startDrilling">三维开孔</button>
            <button type="button" t-att-aria-pressed="this.mode()==='2d'?'true':'false'" t-on-click="() => this.selectTab('holes')">二维</button>
            <button type="button" t-att-aria-expanded="this.assemblyOpen()?'true':'false'" t-on-click="this.openAssembly">装配</button>
        </div>
        <div t-elif="job?.state==='done'" class="nd-bar-actions">
            <div t-if="!job.reference" class="nd-workbar-views" role="group" aria-label="成果视图">
                <button type="button" t-att-aria-pressed="this.archiveMode()==='drawing'?'true':'false'" t-on-click="() => this.archiveMode.set('drawing')">图纸</button>
                <button type="button" t-att-aria-pressed="this.archiveMode()==='3d'?'true':'false'" t-on-click="() => this.archiveMode.set('3d')">本版本三维</button>
            </div>
            <t t-set="directoryLabel" t-value="this.directoryHidden()?'展开目录':'收起目录'"/>
            <button type="button" class="nd-directory-toggle" t-if="this.archiveMode()==='drawing' &amp;&amp; sheet" t-att-aria-expanded="this.directoryHidden()?'false':'true'"
                    t-att-title="directoryLabel" t-att-aria-label="directoryLabel" t-on-click="() => this.directoryHidden.set(!this.directoryHidden())">
                <i class="fa fa-list-ul" aria-hidden="true"/><span>目录</span>
            </button>
            <div class="nd-menu">
                <button type="button" t-att-aria-expanded="this.archiveMenu()==='downloads'?'true':'false'" t-on-click="() => this.toggleArchiveMenu('downloads')">下载</button>
                <div class="nd-popover nd-downloads" t-if="this.archiveMenu()==='downloads'" aria-label="下载文件" t-on-click="() => this.archiveMenu.set(null)">
                    <t t-if="sheet">
                        <a t-att-href="this.drawingFile(job,sheet,'dwg')" t-att-aria-label="'下载'+sheet.name+' DWG'" t-out="job.reference?'当前原图 DWG':'当前图纸 DWG'"/>
                        <a t-if="!job.reference &amp;&amp; sheet.category==='flat'" t-att-href="this.url(job.id,sheet.key+'c')" t-att-aria-label="'下载'+sheet.name+' DXF'">当前切割 DXF</a>
                    </t>
                    <t t-if="!job.reference"><a t-foreach="this.downloads" t-as="link" t-key="link[0]" t-att-href="this.url(job.id,link[0])" t-out="link[1]"/></t>
                </div>
            </div>
            <div class="nd-menu" t-if="!job.reference">
                <button type="button" aria-label="版本详情" title="版本详情" t-att-aria-expanded="this.archiveMenu()==='details'?'true':'false'"
                        t-on-click="() => this.toggleArchiveMenu('details')">⋯</button>
                <section class="nd-popover nd-version-details" t-if="this.archiveMenu()==='details'" aria-label="版本详情">
                    <b><t t-out="job.sheets.length"/> 张 DWG · <t t-out="job.cut_count"/> 份切割 DXF</b>
                    <ul t-if="job.limits?.length"><li t-foreach="job.limits" t-as="limit" t-key="limit_index" t-out="limit"/></ul>
                </section>
            </div>
        </div>
    </div>
    </Portal>
    <t t-set="draft" t-value="this.draftPreview()"/>
    <t t-set="warning" t-value="this.issue() || (draft?.snapshot===form ? draft.issues?.join(' · ') : '')"/>
    <div class="nd-error" role="alert" t-if="!this.showFiles() &amp;&amp; warning" t-out="warning"/>
    <t t-set="assembly" t-value="this.assemblyOpen()"/>
    <div class="nd-layout" t-att-class="{'nd-archive-layout':this.showFiles(),'nd-assembly-layout':assembly,'nd-layout-folded':this.panelHidden() &amp;&amp; !this.showFiles() &amp;&amp; !assembly}"
            t-att-style="'--nd-panel-width:'+this.panelWidth()+'px'">
        <aside class="nd-panel nd-inspector" t-if="!this.showFiles() &amp;&amp; !assembly">
            <div class="nd-inspector-bar">
                <div class="nd-tabs" role="group" aria-label="设计工具">
                    <button type="button" t-foreach="this.tabs" t-as="tup" t-key="tup[0]" t-att-class="this.tab()===tup[0]?'active':''"
                            t-att-aria-pressed="this.tab()===tup[0]?'true':'false'"
                            t-on-click="() => this.selectTab(tup[0], tup[0]==='holes' &amp;&amp; this.mode()==='3d')" t-out="tup[1]"/>
                </div>
                <button type="button" class="nd-inspector-toggle" t-att-title="this.panelHidden()?'展开设计栏':'收起设计栏'"
                        t-att-aria-label="this.panelHidden()?'展开设计栏':'收起设计栏'" t-att-aria-expanded="this.panelHidden()?'false':'true'"
                        t-on-click="() => this.panelHidden.set(!this.panelHidden())" t-out="this.panelHidden()?'›':'‹'"/>
            </div>
            <div class="nd-fields" t-if="!this.panelHidden() &amp;&amp; this.tab()==='cabinet'">
                <h3>基础柜体</h3>
                <div class="nd-switch" role="group" aria-label="选择柜型">
                    <button type="button" t-foreach="['single','double']" t-as="kind" t-key="kind" t-att-disabled="this.busy()"
                            t-att-class="form.kind===kind?'active':''" t-att-aria-pressed="form.kind===kind?'true':'false'"
                            t-on-click="() => this.selectKind(kind)" t-out="this.kindName(kind)"/>
                </div>
                <h3>箱体尺寸 <small>mm</small></h3>
                <div class="nd-trio"><label t-foreach="this.dims" t-as="row" t-key="row[0]"><t t-out="row[1]"/><input type="number" min="1" step="any" t-att-aria-label="'柜'+row[1]" t-att-value="form[row[0]]" t-on-input="ev => this.changeField(row[0],ev,true)"/></label></div>
                <button class="nd-wide" t-att-disabled="this.busy()" t-on-click="() => this.apply('save')">保存并预览柜体</button>
            </div>
            <div class="nd-fields" t-if="!this.panelHidden() &amp;&amp; this.tab()==='materials'">
                <SheetSettings catalog="doc.sheet_catalog" values="form" disabled="this.busy()"
                               change="values => this.patch(values)" save="() => this.apply('save')"/>
            </div>
            <PartsPanel t-if="!this.panelHidden() &amp;&amp; this.tab()==='parts'" parts="this.cabinetParts()"
                        selected="this.selectedParts()" hidden="this.hiddenParts()"
                        select="(ids, locate) => this.selectParts(ids, locate)" toggle="ids => this.toggleParts(ids)"
                        showAll="() => this.hiddenParts.set([])"/>
            <div class="nd-fields" t-if="!this.panelHidden() &amp;&amp; this.tab()==='holes'">
                <div class="nd-board-controls" t-if="this.board()">
                    <details class="nd-face-overview">
                        <summary>总装图选面</summary>
                        <div class="nd-face-map" aria-label="总装方位示意" role="group">
                            <t t-foreach="this.views" t-as="view" t-key="view[0]">
                                <t t-set="face" t-value="this.board(view[0])"/>
                                <button t-if="face" type="button" t-att-data-face="face.id" t-att-aria-label="view[1]+'选择板面'"
                                        t-att-class="face.id===this.face()?'active':''"
                                        t-on-click="() => face.id==='door' ? this.frontFacesOpen.set(!this.frontFacesOpen()) : this.selectBoard(face.id)">
                                    <svg viewBox="0 0 36 26" aria-hidden="true"><rect x="3" y="3" width="30" height="20" rx="2"/>
                                        <path t-if="face.id==='door' &amp;&amp; this.board('door_right')" d="M18 3v20"/><path t-elif="face.id==='top' || face.id==='bottom'" d="M3 10h30"/></svg>
                                    <span t-out="view[1]"/>
                                </button>
                            </t>
                        </div>
                        <div class="nd-front-faces" t-if="this.frontFacesOpen()">
                            <button type="button" t-foreach="this.boards().filter(f => ['door','door_right','mount'].includes(f.id))"
                                    t-as="face" t-key="face.id" t-on-click="() => { this.selectBoard(face.id); this.frontFacesOpen.set(false); }"
                                    t-out="this.faceName(face.id)"/>
                        </div>
                    </details>
                    <div class="nd-face-tiles" role="group" aria-label="加工板面">
                        <button type="button" t-foreach="this.boards()" t-as="face" t-key="face.id" class="nd-face-tile"
                                t-att-data-face="face.id" t-att-class="face.id===this.face()?'active':''"
                                t-att-aria-pressed="face.id===this.face()?'true':'false'" t-on-click="() => this.selectBoard(face.id)">
                            <span t-out="this.faceName(face.id)"/>
                            <small t-att-title="this.boardHoles(face.id).length+' 个自定义孔，'+this.linkedHoles(face.id)+' 个附件孔'">
                                <t t-out="this.boardHoles(face.id).length+this.linkedHoles(face.id)"/> 孔
                            </small>
                        </button>
                    </div>
                    <details class="nd-coordinate-note">
                        <summary>坐标与孔位说明</summary>
                        <p t-out="this.board().axes"/>
                        <p>计数含自定义孔和附件孔。原图结构孔随板面显示。</p>
                    </details>
                </div>
                <div class="nd-empty" t-else="">保存并预览柜体后可选加工板面</div>
                <t t-if="this.board() &amp;&amp; this.holeGeometryReady()">
                    <t t-set="holeIssue" t-value="this.holeIssue()"/>
                    <div class="nd-hole-history" role="group" aria-label="孔位历史">
                        <button type="button" aria-label="撤销孔位" t-att-disabled="this.busy() || !this.holeHistory().undo.length"
                                t-on-click="() => this.travelHoleHistory('undo')">撤销</button>
                        <button type="button" aria-label="重做孔位" t-att-disabled="this.busy() || !this.holeHistory().redo.length"
                                t-on-click="() => this.travelHoleHistory('redo')">重做</button>
                        <label class="nd-drill-snap" t-if="this.drilling()">吸附
                            <select aria-label="拖动吸附" t-on-change="ev => this.drillSnap.set(+ev.target.value)">
                                <option value="1" t-att-selected="this.drillSnap()===1">1 mm</option>
                                <option value="0.1" t-att-selected="this.drillSnap()===0.1">0.1 mm</option>
                                <option value="0" t-att-selected="this.drillSnap()===0">关闭</option>
                            </select>
                        </label>
                    </div>
                    <small t-if="this.holeDraft().copiedFrom" class="nd-hole-copy-note" role="status">复制自 <t t-out="this.holeDraft().copiedFrom"/>，调整位置后确认</small>
                    <label>孔型
                        <select aria-label="孔型" t-att-disabled="this.busy()" t-on-change="ev => this.setHole('type',ev.target.value)">
                            <option t-foreach="[['circle','圆孔'],['rectangle','矩形孔'],['slot','长圆孔']]" t-as="kv" t-key="kv[0]"
                                    t-att-value="kv[0]" t-att-selected="this.hole().type===kv[0]" t-out="kv[1]"/>
                        </select>
                    </label>
                    <div class="nd-duo">
                        <div class="nd-hole-axis" t-foreach="this.holeAxes" t-as="axis" t-key="axis[0]">
                            <t t-set="letter" t-value="axis[0].toUpperCase()"/>
                            <label><t t-out="axis[1]"/>
                                <input type="number" step="any" t-att-aria-label="axis[1]" t-att-value="this.holeValue(axis[0])"
                                       t-att-disabled="this.busy()" t-on-input="ev => this.setHoleValue(axis[0],ev.target.value)" t-on-blur="this.endHoleInput"/>
                            </label>
                            <div class="nd-hole-basis">
                                <select t-att-aria-label="letter+' 坐标基准'" t-att-disabled="this.busy()" t-on-change="ev => this.setHoleBasis(axis[0],ev.target.value)">
                                    <option t-foreach="this.holeBasisOptions" t-as="basis" t-key="basis[0]" t-att-value="basis[0]"
                                            t-att-selected="this.holeBasis(axis[0])===basis[0]" t-out="basis[1]"/>
                                </select>
                                <button type="button" t-att-aria-label="letter+' 向居中'" t-att-title="letter+' 向居中'"
                                        t-att-disabled="this.busy()" t-on-click="() => this.centerHole(axis[0])">居中</button>
                            </div>
                        </div>
                    </div>
                    <div class="nd-duo">
                        <label t-foreach="this.hole().type==='circle'?[['diameter','直径']]:[['width','孔宽'],['height','孔高']]" t-as="kv" t-key="kv[0]">
                            <t t-out="kv[1]"/>
                            <input type="number" min="2" step="any" t-att-aria-label="kv[1]" t-att-value="this.hole()[kv[0]]" t-att-disabled="this.busy()"
                                   t-on-input="ev => this.setHoleSize(kv[0],ev.target.value)" t-on-blur="this.endHoleInput"/>
                        </label>
                    </div>
                    <small t-if="holeIssue &amp;&amp; this.holeDraft().active" class="nd-hole-issue" role="alert" t-out="holeIssue"/>
                    <div class="nd-hole-actions">
                        <button type="button" class="nd-wide nd-soft" t-att-disabled="this.busy() || !!holeIssue" t-on-click="this.addHole"
                                t-out="this.editing()?'应用孔位修改':this.holeDraft().copiedFrom?'确认复制孔':this.drilling()?'确认孔位':'添加孔位'"/>
                        <button type="button" t-if="this.holeDraft().active" t-att-disabled="this.busy()" t-on-click="this.cancelHoleDraft">取消</button>
                    </div>
                    <div class="nd-bomrow" t-foreach="this.boardHoles()" t-as="r" t-key="r.id">
                        <button type="button" class="nd-link" t-att-disabled="this.busy() || this.attachmentHole(r.id)" t-att-aria-pressed="this.editing()===r.id?'true':'false'" t-on-click="() => this.editHole(r)">
                            <b t-out="r.id"/><small><t t-out="r.u"/>，<t t-out="r.v"/> mm</small>
                        </button>
                        <small t-if="this.attachmentHole(r.id)">附件关联</small>
                        <div t-else="" class="nd-hole-row-actions">
                            <button type="button" class="nd-link" t-att-aria-label="'复制 '+r.id" t-att-disabled="this.busy()" t-on-click="() => this.editHole(r,true)">复制</button>
                            <button type="button" class="nd-icon" t-att-aria-label="'移除 '+r.id" t-att-disabled="this.busy()" t-on-click="() => this.removeHole(r.id)">×</button>
                        </div>
                    </div>
                    <button class="nd-wide" t-att-disabled="this.busy()" t-on-click="() => this.apply('save')">保存并预览开孔</button>
                </t>
                <small t-elif="this.board()" class="nd-hole-issue" role="status">请先保存并预览当前规格。</small>
            </div>
        </aside>
        <div t-if="!this.showFiles() &amp;&amp; !assembly &amp;&amp; !this.panelHidden()" class="nd-splitter" role="separator" tabindex="0"
             aria-label="调整设计栏宽度" aria-orientation="vertical" aria-valuemin="270" aria-valuemax="440" t-att-aria-valuenow="this.panelWidth()"
             t-on-pointerdown="this.startPanelResize" t-on-pointermove="this.movePanelResize" t-on-pointerup="this.endPanelResize"
             t-on-pointercancel="this.endPanelResize" t-on-lostpointercapture="this.endPanelResize" t-on-keydown="this.keyPanelResize"/>
        <section class="nd-panel nd-stage">
            <t t-if="!this.showFiles()">
                <t t-set="visual" t-value="this.displayMesh()"/>
                <div class="nd-viewport" t-att-class="{'nd-drill-stage':this.drilling()}">
                    <div class="nd-viewport-head" t-if="this.mode()==='2d' &amp;&amp; this.board()">
                        <div class="nd-board-caption">
                            <b><t t-out="this.faceName(this.face())"/> · <t t-out="this.board().width.toFixed(1)"/> × <t t-out="this.board().height.toFixed(1)"/> mm</b>
                            <small t-if="this.tab()!=='holes'">查看孔位</small>
                        </div>
                    </div>
                    <div class="nd-viewport-head" t-elif="this.drilling() &amp;&amp; this.holeGeometryReady(visual)" role="status">
                        <div class="nd-board-caption nd-drill-caption">
                            <b t-out="this.drillFace() ? this.faceName(this.drillFace()) : '点击板面定位'"/>
                            <small t-if="this.drillNotice()" t-out="this.drillNotice()"/>
                        </div>
                    </div>
                    <div class="nd-three-host" t-att-hidden="this.mode()!=='3d' || !visual" t-ref="this.threeHost"/>
                    <canvas t-if="this.mode()==='2d'" aria-label="板面开孔定位" t-ref="this.canvas" t-on-pointerdown="this.flatPointerDown" t-on-pointerup="this.flatPointerUp" t-on-pointercancel="() => { this.flatPress=null; }" t-on-wheel.prevent="ev => this.faceView?.scale(ev.deltaY)"/>
                    <div t-if="this.mode()==='3d' &amp;&amp; this.viewerError()" class="nd-overlay" role="alert" t-out="this.viewerError()"/>
                    <div t-elif="!visual" class="nd-overlay" t-att-role="draft?.error?'alert':'status'">
                        <t t-if="draft">
                            <b t-out="draft.error ? this.kindName(form.kind)+'预览失败' : '正在生成'+this.kindName(form.kind)+'预览'"/>
                            <small t-out="draft.error || draft.stage"/>
                            <progress t-if="!draft.error" class="nd-preview-progress" aria-label="正在计算柜体预览"/>
                        </t>
                        <t t-else="">
                            <b t-out="doc.jobs[0]?.state==='failed'?'模型生成失败':doc.jobs.length?'正在准备模型':'尚未生成柜体预览'"/>
                            <small t-if="!doc.jobs.length">选择柜型和规格后点击「保存并预览柜体」</small>
                        </t>
                    </div>
                    <div class="nd-vtools" t-if="visual">
                        <button t-if="this.drilling() &amp;&amp; this.holeGeometryReady(visual)" type="button" t-on-click="this.focusBoard"
                                t-out="this.boardView()?'返回整柜':'正对板面'"/>
                        <button t-if="this.mode()==='3d' &amp;&amp; !this.boardView()" t-on-click="() => this.opened.set(!this.opened())" t-out="this.opened()?'合上柜门':'打开柜门'"/>
                        <button t-on-click="this.fitView" t-out="this.mode()==='2d'?'适应板面':'复位视角'"/>
                        <ExplosionControls t-if="this.mode()==='3d'" value="this.drilling()?0:this.explosion()"
                                           change="value => this.explosion.set(value)" fit="() => this.fitView()" activate="() => this.beginExplosion()"/>
                    </div>
                </div>
                <div class="nd-foot">
                    <span><t t-if="visual"><b t-out="'AE '+this.kindName(visual.parameters.configuration.kind)"/> · 宽 <t t-out="visual.dimensions.width"/> / 高 <t t-out="visual.dimensions.height"/> / 深 <t t-out="visual.dimensions.depth"/> mm</t></span>
                    <small t-out="this.previewNote()"/>
                </div>
            </t>
            <div t-else="" class="nd-files">
                <div class="nd-empty" t-if="!job">尚无图纸版本</div>
                <div class="nd-empty" role="status" t-elif="job.state==='unavailable'">当前柜型的基础原图尚未准备</div>
                <div t-elif="job.state!=='done'" class="nd-empty nd-archive-state" role="status">
                    <b t-out="this.jobState(job)"/>
                    <p t-out="job.error || job.stage"/>
                    <progress t-if="job.state==='running'" max="100" t-att-value="job.progress"/>
                </div>
                <t t-elif="this.archiveMode()==='3d'">
                    <div t-if="!job.files.includes('mesh') || this.viewerError()" class="nd-empty" role="status" t-out="this.viewerError() || '本版本未归档三维模型'"/>
                    <t t-else="" t-key="job.id">
                        <ArchivedCabinet src="this.url(job.id,'mesh')" revision="'V'+this.version(job.version)"/>
                    </t>
                </t>
                <div t-else="" class="nd-sheet-grid" t-att-class="{'nd-directory-hidden':this.directoryHidden()}">
                    <div class="nd-sheet-list" aria-label="图纸目录" t-if="!this.directoryHidden()">
                        <div class="nd-sheet" t-foreach="job.sheets" t-as="s" t-key="s.key">
                            <button type="button" t-att-class="sheet.key===s.key?'active':''" t-att-aria-pressed="sheet.key===s.key?'true':'false'"
                                    t-on-click="() => this.sheet.set(s.key)"><small t-out="this.docTypes[s.category]"/><t t-out="s.name"/></button>
                        </div>
                    </div>
                    <t t-if="sheet">
                        <t t-set="viewKey" t-value="job.id + '/' + sheet.key"/>
                        <t t-key="viewKey">
                            <DrawingViewport src="this.drawingFile(job,sheet,'svg')" title="sheet.name" showTitle="this.directoryHidden()"
                                             initialView="this.drawingView(viewKey)" remember="view => this.rememberDrawingView(viewKey,view)"/>
                        </t>
                    </t>
                    <div t-else="" class="nd-empty">本版本暂无图纸</div>
                </div>
            </div>
            <t t-set="recent" t-value="doc.jobs[0]"/>
            <div class="nd-progress" t-if="!this.showFiles() &amp;&amp; recent &amp;&amp; ['queued','running'].includes(recent.state)"><span t-out="recent.stage"/><progress max="100" t-att-value="recent.progress"/><small><t t-out="recent.progress"/>%</small></div>
        </section>
        <aside class="nd-panel nd-assembly" aria-label="装配" t-if="assembly">
            <div class="nd-assembly-head nd-between">
                <h3>附件库匹配 <small>每台</small></h3>
                <button type="button" class="nd-inspector-toggle" aria-label="关闭装配" title="关闭装配" t-on-click="this.openAssembly">×</button>
            </div>
            <div class="nd-fields">
                <small t-if="!doc.bom.lines.length">此柜体尚无附件。</small>
                <div class="nd-match" t-foreach="doc.bom.lines" t-as="line" t-key="line_index">
                    <t t-set="row" t-value="this.rowInfo(line_index)"/>
                    <div class="nd-between"><strong><t t-out="line.code"/> × <t t-out="line.quantity"/></strong><span class="nd-tag" t-out="row.status"/></div>
                    <label>附件型号<select t-att-aria-label="'第'+(line_index+1)+'行型号'" t-on-change="ev => this.links(line_index,'code',ev.target.value)">
                        <option value="" t-if="!row.model">选择附件型号</option>
                        <option t-foreach="Object.entries(doc.library)" t-as="entry" t-key="entry[0]" t-att-value="entry[0]" t-att-selected="row.code===entry[0]"><t t-out="entry[1].name"/> · <t t-out="entry[0]"/></option>
                    </select></label>
                    <label t-if="row.model">安装面<select t-att-aria-label="'第'+(line_index+1)+'行安装面'" t-on-change="ev => this.links(line_index,'face',ev.target.value)">
                        <option t-if="!row.validFace" value="" selected="">选择适用安装面</option>
                        <option t-foreach="this.mountingFaces(row.model)" t-as="id" t-key="id" t-att-value="id" t-att-selected="row.face===id" t-out="this.faceName(id)"/></select></label>
                    <small t-if="row.model">模型版本 <t t-out="row.model.version"/> · 已装 <t t-out="row.placed"/> / <t t-out="line.quantity"/></small>
                </div>
                <button t-if="doc.bom.lines.length" class="nd-wide nd-soft" t-att-disabled="this.busy()" t-on-click="() => this.apply('assemble')">一键装配</button>
                <t t-foreach="form.instances" t-as="a" t-key="a.id"><div class="nd-match" t-if="['step','lock'].includes(doc.library[a.code].kind)">
                    <h3 t-out="doc.library[a.code].name"/><small t-out="doc.library[a.code].placement?.anchor==='right'?'横向距板面右边，纵向相对板面中心（mm）':'相对板面中心定位（mm）'"/>
                    <div class="nd-trio"><label t-foreach="[['u','横向'],['v','纵向']]" t-as="k" t-key="k[0]"><t t-out="k[1]"/><input type="number" step="any" t-att-value="form.positions?.[a.id]?.[k[0]] ?? a[k[0]]" t-on-input="ev => this.position(a,k[0],ev)"/></label>
                    <label>转角<select t-on-change="ev => this.position(a,'rotation',ev)"><option t-foreach="[0,90,180,270]" t-as="v" t-key="v" t-att-value="v" t-att-selected="(form.positions?.[a.id]?.rotation ?? a.rotation)===v"><t t-out="v"/>°</option></select></label></div>
                </div></t>
            </div>
        </aside>
    </div>
    </t>
</main>
</t>
<t t-name="nodo_draw.DrawingViewport">
    <div class="nd-drawing-viewer">
        <div class="nd-reader-tools" role="toolbar" aria-label="图纸查看工具">
            <div class="nd-zoom-controls">
                <button type="button" aria-label="缩小图纸" title="缩小" t-att-disabled="this.status()!=='ready' || this.view().zoom&lt;=1" t-on-click="this.zoomOut">−</button>
                <output aria-label="图纸缩放比例"><t t-out="Math.round(this.view().zoom*100)"/>%</output>
                <button type="button" aria-label="放大图纸" title="放大" t-att-disabled="this.status()!=='ready' || this.atZoomLimit()" t-on-click="this.zoomIn">+</button>
            </div>
            <span t-if="this.props.showTitle" class="nd-reader-title" t-out="this.props.title"/>
            <button type="button" t-att-disabled="this.status()!=='ready'" t-on-click="this.fit">适应窗口</button>
        </div>
        <div class="nd-drawing-surface" t-att-class="{'nd-pan-ready':this.status()==='ready'}" t-ref="this.surface"
                t-on-wheel.prevent="this.wheel" t-on-pointerdown="this.beginPan" t-on-pointermove="this.pan"
                t-on-pointerup="this.endPan" t-on-pointercancel="this.endPan" t-on-lostpointercapture="this.endPan">
            <img class="nd-drawing" t-att-src="this.props.src" t-att-alt="this.props.title" t-att-hidden="this.status()!=='ready'"
                draggable="false" t-att-style="this.imageStyle()" t-on-load="this.imageLoaded" t-on-error="() => this.status.set('error')"/>
            <div t-if="this.status()!=='ready'" class="nd-empty" role="status" t-out="this.status()==='error'?'本图纸预览暂时无法读取':'正在加载图纸'"/>
        </div>
    </div>
</t>
<t t-name="nodo_draw.ArchivedCabinet">
    <div class="nd-viewport nd-archive-model" aria-label="本版本三维模型">
        <div class="nd-viewport-head"><b><t t-out="this.props.revision"/> · 本版本三维</b></div>
        <t t-if="this.mesh()">
            <div class="nd-three-host" t-ref="this.host"/>
            <div class="nd-vtools">
                <button type="button" t-on-click="() => this.opened.set(!this.opened())" t-out="this.opened()?'合上柜门':'打开柜门'"/>
                <button type="button" t-on-click="() => this.reset.set(this.reset()+1)">复位视角</button>
                <ExplosionControls value="this.explosion()" change="value => this.explosion.set(value)"
                                   fit="() => this.reset.set(this.reset()+1)"/>
            </div>
        </t>
        <div t-else="" class="nd-overlay" role="status" t-out="this.error() || '正在加载本版本三维'"/>
    </div>
</t>
</templates>
