<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-inherit="nodo_draw.Workbench" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='this.openDesign']" position="attributes">
            <attribute name="t-att-aria-pressed">!this.showFiles() &amp;&amp; !this.quoteOpen()?'true':'false'</attribute>
        </xpath>
        <xpath expr="//button[@t-on-click='this.showThree']" position="attributes">
            <attribute name="t-att-aria-pressed">!this.auxiliaryOpen() &amp;&amp; this.mode()==='3d' &amp;&amp; !this.drilling()?'true':'false'</attribute>
        </xpath>
        <xpath expr="//button[@t-on-click='this.openAccessoryLibrary']" position="after">
            <button type="button" class="nd-quote-entry" t-att-aria-pressed="this.quoteOpen()?'true':'false'"
                t-on-click="() => this.openQuote()">报价</button>
        </xpath>
        <xpath expr="//div[hasclass('nd-layout')]" position="before">
            <section t-if="this.quoteOpen()" class="nd-quote-header" aria-label="报价核算概览">
                <div class="nd-quote-identity">
                    <h2>报价</h2>
                    <p t-if="form.width &amp;&amp; form.depth &amp;&amp; form.height" aria-label="柜体尺寸（宽 × 深 × 高）">
                        <t t-out="form.width"/> × <t t-out="form.depth"/> × <t t-out="form.height"/> mm
                    </p>
                </div>
                <div class="nd-quote-tabs" role="group" aria-label="报价页签">
                    <button type="button" t-att-aria-pressed="!this.auxiliaryOpen()?'true':'false'"
                        t-on-click="() => this.openQuote('parts')">零件</button>
                    <button type="button" t-att-aria-pressed="this.auxiliaryOpen()?'true':'false'"
                        t-on-click="() => this.openQuote('auxiliary')">辅材</button>
                </div>
                <t t-set="totals" t-value="this.quoteTotals(doc, form)"/>
                <dl class="nd-quote-totals" aria-label="每台成本">
                    <div><dt>板料</dt><dd data-quote-sheet=""><b t-if="totals.boards!==null" t-out="totals.boards.toFixed(2)"/></dd>
                        <small t-if="totals.boardNote" t-out="totals.boardNote"/></div>
                    <div><dt>辅材</dt><dd data-auxiliary-total=""><b t-if="totals.supplies!==null" t-out="totals.supplies.toFixed(2)"/></dd>
                        <small t-if="totals.auxiliaryNote" t-out="totals.auxiliaryNote"/></div>
                    <div class="nd-quote-sum"><dt>合计 <small>元/台</small></dt>
                        <dd t-if="totals.sum!==null" data-quote-total=""><b t-out="totals.sum.toFixed(2)"/></dd>
                        <small t-else="" class="nd-quote-pending">待齐备</small></div>
                </dl>
            </section>
            <AuxiliaryCost t-key="doc.id" designId="doc.id" edit="this.localEdit" spec="this.auxiliarySpec(doc, form)"
                dirty="this.dirty() || this.busy()" active="this.quoteOpen()" visible="this.auxiliaryOpen()"
                onCosts="this.reportQuoteAuxiliaryCosts"/>
        </xpath>
        <xpath expr="//div[hasclass('nd-layout')]" position="attributes">
            <attribute name="t-att-hidden">this.auxiliaryOpen()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('nd-tabs')]" position="attributes">
            <attribute name="t-if">!this.quoteOpen()</attribute>
        </xpath>
        <xpath expr="//t[@t-if=&quot;!this.panelHidden() &amp;&amp; this.tab()==='parts'&quot;]" position="attributes">
            <attribute name="t-if">this.tab()==='parts'</attribute>
        </xpath>
        <xpath expr="//div[hasclass('nd-parts-views')]" position="attributes">
            <attribute name="t-if">!this.panelHidden() &amp;&amp; this.hasSheetUsage()</attribute>
        </xpath>
        <xpath expr="//t[SheetUsage]" position="replace">
            <div t-if="this.hasSheetUsage()" class="nd-quote-sheet" t-att-hidden="!this.usageOpen() || this.panelHidden()">
                <t t-set="meshId" t-value="this.sheetMeshId()"/>
                <SheetUsage t-if="meshId" t-key="meshId" designId="doc.id" edit="doc.edit_number" meshId="meshId"
                    selected="this.selectedParts()" select="ids => this.selectParts(ids)"
                    onPrices="this.reportQuoteSheetCosts" visible="this.usageOpen() &amp;&amp; !this.panelHidden() &amp;&amp; !this.auxiliaryOpen()"/>
                <p t-else="" class="nd-empty" role="status"
                    t-out="this.dirty() ? '请保存并预览已修改的柜体，再查看板料用量' : '正在等待当前版本的三维模型'"/>
            </div>
        </xpath>
        <xpath expr="//PartsPanel" position="attributes">
            <attribute name="t-else"/>
            <attribute name="t-if">!this.panelHidden() &amp;&amp; !this.usageOpen()</attribute>
        </xpath>
        <xpath expr="//p[@t-if='!doc.sheet_usage_enabled &amp;&amp; doc.bom.drawing_number']" position="attributes">
            <attribute name="t-if">!this.panelHidden() &amp;&amp; !doc.sheet_usage_enabled &amp;&amp; doc.bom.drawing_number</attribute>
        </xpath>
    </t>

    <t t-name="nodo_draw_cost.AuxiliaryCost">
        <section t-if="this.props.visible" class="nd-auxiliary" aria-label="辅材核算">
            <t t-set="data" t-value="this.rowsData()"/>
            <t t-set="ready" t-value="this.currentData()"/>
            <div class="nd-aux-body" t-att-aria-busy="!ready &amp;&amp; !this.readError()?'true':'false'">
                <p t-if="this.readError()" class="nd-aux-issue" role="alert" t-out="this.readError()"/>
                <p t-if="!data &amp;&amp; !this.readError()" class="nd-empty" role="status">正在核算辅材…</p>
                <t t-if="data">
                    <div class="nd-aux-basis">
                        <span><b t-out="data.kind==='single'?'单开门':data.kind==='double'?'双开门':'待确认门型'"/>
                            <t t-if="data.height"> · 柜体高 <b t-out="data.height"/> mm</t><t t-if="data.variant"> · <t t-out="data.variant"/></t>
                        </span>
                        <a href="/odoo/auxiliary-library" target="_blank" rel="noopener">辅料库 ↗</a>
                    </div>
                    <p t-if="this.props.dirty" class="nd-aux-issue" role="status">当前为规格预览，保存柜体规格后可保存辅材选配。</p>
                    <p t-if="ready &amp;&amp; data.missing" role="status" class="nd-aux-issue">
                        <t t-out="data.missing"/> 项待核对 · 已计价 <t t-out="data.known_subtotal.toFixed(2)"/> 元/台
                    </p>
                    <p t-foreach="data.issues" t-as="issue" t-key="issue" class="nd-aux-issue" t-out="issue"/>

                    <section class="nd-aux-list" aria-labelledby="nd-aux-standard-title">
                        <header class="nd-aux-heading"><h3 id="nd-aux-standard-title">标配</h3>
                            <span t-out="data.rule_source+' · 采购清单待核对'"/>
                        </header>
                        <div t-if="data.standard.length" class="nd-aux-table-wrap">
                            <table class="nd-aux-table" aria-label="标配辅材">
                                <t t-set="editable" t-value="false"/>
                                <t t-call="nodo_draw_cost.AuxiliaryColumns"/>
                                <tbody>
                                    <t t-foreach="data.standard.filter(row => !row.lock_item)" t-as="row" t-key="row.code">
                                        <t t-call="nodo_draw_cost.AuxiliaryLine"/>
                                    </t>
                                </tbody>
                                <tbody t-if="data.auto_lock">
                                    <tr class="nd-aux-lock-row">
                                        <th colspan="5" scope="rowgroup">
                                            <div class="nd-aux-lock-bar">
                                                <button type="button" class="nd-aux-quiet" t-att-aria-expanded="this.lockExpanded()?'true':'false'"
                                                    aria-label="锁具组合明细" t-on-click="() => this.lockExpanded.set(!this.lockExpanded())">
                                                    <i class="fa" t-att-class="this.lockExpanded()?'fa-angle-down':'fa-angle-right'" aria-hidden="true"/>
                                                    锁具组合 <b t-out="data.selected_lock"/>
                                                </button>
                                                <span t-if="data.lock_change" role="status" class="nd-aux-lock-difference">
                                                    <t t-out="data.lock_change.previous"/> → <t t-out="data.lock_change.current"/>
                                                    <b t-if="data.lock_change.difference!==null" data-aux-lock-difference=""
                                                        t-out="(data.lock_change.difference>=0?'+':'')+data.lock_change.difference.toFixed(2)+' 元/台'"/>
                                                </span>
                                                <span t-if="data.standard.some(row => row.lock_item &amp;&amp; row.issue)"
                                                    class="nd-aux-row-issue">锁具待核对</span>
                                                <button type="button" class="nd-aux-quiet nd-aux-lock-action"
                                                    t-att-aria-expanded="this.lockEditor() || data.lock_pending?'true':'false'"
                                                    t-on-click="() => this.lockEditor.set(!this.lockEditor())">锁具换配</button>
                                            </div>
                                            <div t-if="this.lockEditor() || data.lock_pending" class="nd-aux-lock-editor">
                                                <t t-set="lock" t-value="this.choices().lock"/>
                                                <label>锁具组合
                                                    <select aria-label="锁具组合" t-att-disabled="this.saving()" t-on-change="ev => this.setLock(ev.target.value)">
                                                        <option value="" t-att-selected="!lock">按柜高选取</option>
                                                        <option value="MS813" t-att-selected="lock?.scheme==='MS813'">MS813 × 1</option>
                                                        <option value="MS821" t-att-selected="lock?.scheme==='MS821'">MS821 × 1 ＋ 配套锁杆</option>
                                                    </select>
                                                </label>
                                                <label t-if="lock">换配依据
                                                    <input type="text" maxlength="240" aria-label="换配依据" t-att-value="lock.reason"
                                                        placeholder="填写图纸或项目要求" t-att-disabled="this.saving()"
                                                        t-on-change="ev => this.confirmLock(ev.target.value)"/>
                                                </label>
                                                <button t-if="lock &amp;&amp; data.lock_pending &amp;&amp; lock.reason" type="button"
                                                    class="nd-aux-quiet" t-att-disabled="this.saving()"
                                                    t-on-click="() => this.confirmLock(lock.reason)">按当前规格确认换配</button>
                                            </div>
                                            <p t-if="this.choices().lock &amp;&amp; !data.lock_pending" class="nd-aux-lock-reason">
                                                换配依据 · <t t-out="this.choices().lock.reason"/>
                                            </p>
                                        </th>
                                    </tr>
                                    <t t-if="this.lockExpanded()" t-foreach="data.standard.filter(row => row.lock_item)" t-as="row" t-key="row.code">
                                        <t t-call="nodo_draw_cost.AuxiliaryLine"/>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <p t-else="" class="nd-aux-empty">等待柜型与图版确认。</p>
                    </section>

                    <section class="nd-aux-list" aria-labelledby="nd-aux-optional-title">
                        <header class="nd-aux-heading">
                            <h3 id="nd-aux-optional-title">自选</h3>
                            <button type="button" class="nd-aux-add-button" t-att-disabled="!ready || this.saving() || this.choices().items.length>=100"
                                t-on-click="this.openPicker"><i class="fa fa-plus" aria-hidden="true"/> 添加辅材</button>
                        </header>
                        <div t-if="data.optional.length" class="nd-aux-table-wrap">
                            <table class="nd-aux-table nd-aux-optional-table" aria-label="自选辅材">
                                <t t-set="editable" t-value="true"/>
                                <t t-call="nodo_draw_cost.AuxiliaryColumns"/>
                                <tbody>
                                    <t t-foreach="data.optional" t-as="row" t-key="row.source+':'+(row.id || row.code)">
                                        <t t-call="nodo_draw_cost.AuxiliaryLine"/>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <p t-else="" class="nd-aux-empty">暂无自选辅材</p>
                    </section>
                </t>
            </div>
            <footer class="nd-aux-actions" t-if="data || this.draft()">
                <div class="nd-aux-save-status" aria-live="polite">
                    <p t-if="this.saveError()" class="nd-aux-row-issue" role="alert" t-out="this.saveError()"/>
                    <p t-elif="this.message()" role="status" t-out="this.message()"/>
                    <p t-elif="this.draft()" role="status">有未保存的辅材选配</p>
                </div>
                <button t-if="this.draft()" type="button" class="nd-aux-quiet"
                    t-att-disabled="this.saving()" t-on-click="this.discard">恢复已保存选配</button>
                <button type="button" class="nd-aux-save"
                    t-att-disabled="!data || !this.draft() || this.props.dirty || this.saving()"
                    t-on-click="this.save" t-out="this.saving()?'正在保存…':'保存辅材选配'"/>
            </footer>
        </section>
    </t>

    <t t-name="nodo_draw_cost.AuxiliaryColumns">
        <colgroup>
            <col class="nd-aux-col-item"/><col class="nd-aux-col-condition"/><col class="nd-aux-col-quantity"/>
            <col class="nd-aux-col-price"/><col class="nd-aux-col-amount"/><col t-if="editable" class="nd-aux-col-action"/>
        </colgroup>
        <thead><tr>
            <th scope="col">物料</th><th scope="col">依据／状态</th><th scope="col">每台用量</th><th scope="col">单价（元）</th><th scope="col">金额（元）</th>
            <th t-if="editable" scope="col"><span class="visually-hidden">操作</span></th>
        </tr></thead>
    </t>

    <t t-name="nodo_draw_cost.AuxiliaryLine">
        <tr t-att-data-aux-code="row.code">
            <th scope="row"><b t-out="row.name"/><small t-if="row.code" t-out="row.code"/></th>
            <td class="nd-aux-condition">
                <span t-if="row.condition" t-out="row.condition"/>
                <span t-elif="row.source==='handoff'">交接清单</span>
                <span t-elif="row.source==='manual'" t-out="this.rowsData().standard.some(item => item.code===row.code)?'增购':'手工自选'"/>
                <span t-else="">固定标配</span>
                <small t-if="row.issue &amp;&amp; row.issue!=='待补价'" class="nd-aux-row-issue" t-out="row.issue"/>
            </td>
            <td class="nd-aux-quantity"><div>
                    <input t-if="row.source==='manual'" type="number" t-att-aria-label="row.name+'每台用量'"
                        t-att-min="row.unit==='metre'?0.001:1" t-att-step="row.unit==='metre'?0.001:1" max="10000" required=""
                        t-att-value="row.quantity" t-att-disabled="this.saving()" t-on-change="ev => this.setQuantity(row, ev.target)"/>
                    <b t-else="" t-out="row.quantity"/><small t-out="row.unit_label"/>
                </div></td>
            <td><t t-if="row.price!==null"><t t-out="this.unitPrice(row.price)"/><small t-if="row.basis==='reference'">参考价</small></t>
                <small t-else="" class="nd-aux-row-issue" t-out="row.issue==='待补价'?'待补价':'—'"/>
            </td>
            <td><b t-out="row.amount===null?'—':row.amount.toFixed(2)"/></td>
            <td t-if="row.source==='manual' || row.source==='handoff'">
                <button t-if="row.source==='manual'" type="button" class="nd-aux-remove"
                    t-att-disabled="this.saving()" t-att-aria-label="'移除'+row.name" t-on-click="() => this.remove(row.id)">移除</button>
            </td>
        </tr>
    </t>

    <t t-name="nodo_draw_cost.AuxiliaryPicker">
        <Dialog size="'md'" header="false" withBodyPadding="false" contentClass="'nd-aux-drawer'" bodyClass="'nd-aux-drawer-body'">
            <section class="nd-aux-picker" aria-label="选料抽屉">
                <header class="nd-aux-picker-head">
                    <h2>添加辅材</h2>
                    <button type="button" class="btn-close" aria-label="关闭选料抽屉" t-on-click="this.props.close"/>
                </header>
                <div class="nd-aux-search">
                    <i class="fa fa-search" aria-hidden="true"/>
                    <input type="search" t-ref="this.search" aria-label="搜索物料名称或编码" placeholder="搜索物料名称或编码"
                        t-att-value="this.query()" t-on-input="ev => this.query.set(ev.target.value)"/>
                </div>
                <div class="nd-aux-matches" role="group" aria-label="可选辅材">
                    <t t-set="items" t-value="this.matches()"/>
                    <button t-foreach="items" t-as="item" t-key="item.id" type="button" class="nd-aux-match"
                        t-att-aria-pressed="this.selectedId()===item.id?'true':'false'"
                        t-att-data-picker-code="item.code" t-on-click="() => this.select(item.id)">
                        <span><b t-out="item.name"/><small><t t-out="item.code"/> · <t t-out="item.variant"/>
                            <t t-if="item.standard_quantity"> · 增购</t></small></span>
                        <span class="nd-aux-match-price">
                            <b t-if="item.price!==null"><t t-out="this.unitPrice(item.price)"/> 元/<t t-out="item.unit"/></b>
                            <small t-elif="item.price===null" class="nd-aux-row-issue">待补价 · <t t-out="item.unit"/></small>
                            <small t-if="item.basis==='reference'">参考价</small>
                        </span>
                    </button>
                    <p t-if="!items.length" class="nd-aux-empty">没有匹配的可选辅材</p>
                </div>
                <t t-set="selected" t-value="this.selected()"/>
                <div class="nd-aux-picker-selected" t-if="selected" t-key="selected.id">
                    <b t-out="selected.name"/>
                    <small t-if="selected.standard_quantity">标配 <t t-out="selected.standard_quantity"/> <t t-out="selected.unit"/>，填写每台增购用量</small>
                    <div class="nd-aux-picker-quantity">
                        <label>每台用量
                            <span class="nd-aux-picker-count">
                                <input type="number" aria-label="添加的每台用量" t-att-value="this.quantity()"
                                    max="10000" required="" t-att-min="selected.measure==='metre'?0.001:1"
                                    t-att-step="selected.measure==='metre'?0.001:1" t-on-input="ev => this.changeQuantity(ev.target)"/>
                                <small t-out="selected.unit"/>
                            </span>
                        </label>
                        <strong t-if="selected.price!==null &amp;&amp; this.validQuantity()" data-picker-amount=""
                            t-out="this.amount(selected)+' 元/台'"/>
                        <small t-elif="selected.price===null" class="nd-aux-row-issue">待补价</small>
                    </div>
                    <p t-if="!this.validQuantity()" class="nd-aux-row-issue" role="status"
                        t-out="selected.measure==='metre'?'请输入 0.001 至 10000 米，最多三位小数。':'请输入 1 至 10000 的整数。'"/>
                </div>
                <p t-if="this.issue()" class="nd-aux-row-issue" role="alert" t-out="this.issue()"/>
            </section>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="this.props.close">取消</button>
                <button type="button" class="btn btn-primary" t-att-disabled="!this.selected() || !this.validQuantity()" t-on-click="this.add">加入清单</button>
            </t>
        </Dialog>
    </t>
</templates>
