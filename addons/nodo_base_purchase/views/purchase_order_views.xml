<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_order_form_share_to_chat" model="ir.ui.view">
        <field name="name">purchase.order.form.nodo.share.to.chat</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_nodo_share_to_chat" type="object" string="发到聊天" groups="base.group_user"/>
            </xpath>
        </field>
    </record>
</odoo>
